// Rent-Base Datenmodell, Etappe 1
// Jede fachliche Tabelle trägt tenantId (Mandant). PostgreSQL lokal (prisma dev) und auf dem Server.
// Enums sind bewusst als String abgelegt; gültige Werte stehen in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String  @id @default(cuid())
  name                   String
  slug                   String  @unique
  street                 String?
  zip                    String?
  city                   String?
  phone                  String?
  email                  String?
  rentalTermsVersion     String? // z. B. "2026-09"
  rentalTermsText        String? // Mietbedingungen vor der Versionierung (Altbestand); neue Verträge nutzen RentalTermsVersion
  businessRules          Json? // Geschäftsregeln des Mandanten (Phase 15), null = Standardwerte; Struktur in src/lib/business-rules.ts
  privacyNoticeReference String? // Verweis (Text oder Adresse) auf die Datenschutzinformationen, getrennt von den Mietbedingungen
  rentalTermsSequence    Int     @default(0) // fortlaufender Zähler der Fassungsnummern; verworfene Entwürfe geben ihre Nummer nicht zurück
  numberRanges           Json? // Nummernkreise der Belege (Phase 17): { invoice: { prefix }, creditNote: { prefix }, cancellation: { prefix } }; null = RE / GS / ST
  // Behörden-Automatik: tägliche Fristen-Erinnerung per E-Mail (0 = aus), Empfänger leer = alle aktiven Inhaber/Disponenten
  authorityReminderDays  Int     @default(3)
  authorityReminderEmail String?

  // Plattformebene (Befehl 20): Mandantenstatus, unabhängig von Belegnummernkreisen. PENDING_SETUP nur informativ
  // (Onboarding-Hinweis), blockiert für sich allein nichts; SUSPENDED blockiert Login/Mutationen serverseitig.
  status          String    @default("ACTIVE") // PENDING_SETUP | ACTIVE | SUSPENDED
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedById   String? // User.id des SUPER_ADMIN, nur Referenz (kein Fremdschlüssel, analog AuditLog.userId)
  suspendedByName String?

  // Rechnungsdaten (Phase 8). "street" enthält Straße und Hausnummer, keine doppelte Speicherung.
  legalForm        String? // z. B. GmbH, e. K., Einzelunternehmen; Teil des vollständigen Unternehmensnamens
  country          String   @default("DE")
  vatId            String? // Umsatzsteuer-Identifikationsnummer
  taxNumber        String? // Steuernummer
  bankName         String?
  iban             String?
  bic              String?
  invoiceFooter    String? // Fußtext auf Rechnungen
  paymentTermDays  Int? // Zahlungsziel in Tagen ab Rechnungsdatum
  defaultTaxRate   Decimal? // Steuersatz in Prozent für Rechnungspositionen; null = noch nicht konfiguriert
  pricesIncludeTax Boolean? // true: Vertrags- und Zusatzkostenbeträge sind Bruttobeträge; null = noch nicht entschieden
  taxNote          String? // Hinweistext, der bei Positionen mit 0 % auf der Rechnung erscheint (Inhalt entscheidet der Inhaber)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users     User[]
  groups    VehicleGroup[]
  vehicles  Vehicle[]
  customers Customer[]
  bookings  Booking[]

  invitations              Invitation[]
  supportSessions          SupportSession[]
  sketches                 VehicleSketch[]
  contracts                RentalContract[]
  contractDrivers          ContractDriver[]
  handovers                Handover[]
  damages                  Damage[]
  handoverDamages          HandoverDamage[]
  checklistTemplates       ChecklistTemplate[]
  checklistItems           HandoverChecklistItem[]
  photos                   Photo[]
  signatures               Signature[]
  documents                Document[]
  extraCharges             ExtraCharge[]
  emailLogs                EmailLog[]
  vehicleEvents            VehicleEvent[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  deposits                 SecurityDeposit[]
  depositEvents            SecurityDepositEvent[]
  auditLogs                AuditLog[]
  invoiceVersions          InvoiceVersion[]
  invoiceVersionItems      InvoiceVersionItem[]
  damageCases              DamageCase[]
  damageCaseEvents         DamageCaseEvent[]
  damageCaseDocuments      DamageCaseDocument[]
  maintenancePlans         MaintenancePlan[]
  maintenanceRecords       MaintenanceRecord[]
  maintenanceEvents        MaintenanceEvent[]
  vehicleDocuments         VehicleDocument[]
  maintenanceDocumentLinks MaintenanceDocumentLink[]
  authorityCases           AuthorityCase[]
  authorityCaseDocuments   AuthorityCaseDocument[]
  authorityResponses       AuthorityResponse[]
  authorityReceipts        AuthoritySubmissionReceipt[]
  authorityCaseEvents      AuthorityCaseEvent[]
  authorityContacts        AuthorityContact[]
  authorityUploads         AuthorityUpload[]
  rentalTermsVersions      RentalTermsVersion[]
  payouts                  Payout[]
  driverVerifications      DriverVerification[]
  driverDocumentCopies     DriverDocumentCopy[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("OWNER") // OWNER | DISPO | YARD (Mandantenrolle)
  active       Boolean   @default(true)
  platformRole String    @default("NONE") // NONE | SUPER_ADMIN (Plattformrolle, Befehl 20) – strikt getrennt von "role"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            Session[]
  handovers           Handover[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@index([platformRole])
}

// ============================================================================
// Plattformebene (Befehl 20): Super-Admin, Mandantenverwaltung, Einladungen, Passwort-Reset, Supportzugriff.
// Kein Membership-Modell: ein User gehört weiterhin zu genau einem Tenant (Bestandsarchitektur), Details im Bericht.
// ============================================================================

// Einladung zu einem Mandanten: erste OWNER-Einladung bei Mandantenanlage durch SUPER_ADMIN, oder weitere
// Mitarbeiter durch den OWNER. Token nur gehasht gespeichert, single-use, zeitlich begrenzt.
model Invitation {
  id       String @id @default(cuid())
  tenantId String
  email    String
  role     String // OWNER | DISPO | YARD – Mandantenrolle, die der eingeladene Benutzer erhält

  tokenHash String   @unique
  status    String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt DateTime

  invitedById    String? // User.id, nur Referenz (kann SUPER_ADMIN oder OWNER sein)
  invitedByName  String?
  acceptedUserId String? // User.id des neu angelegten Kontos, erst nach Annahme gesetzt

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
}

// Einmaliger Passwort-Reset-Token, nur gehasht gespeichert, single-use, zeitlich begrenzt.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Zeitlich begrenzter, read-only Supportzugriff eines SUPER_ADMIN auf einen Mandanten. Vollständig protokolliert.
model SupportSession {
  id             String    @id @default(cuid())
  tenantId       String
  superAdminId   String // User.id, nur Referenz
  superAdminName String
  reason         String
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([superAdminId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fahrzeuggruppe: z. B. Transporter 3,5 t, Kompaktklasse. Preise dienen als Vorgabe beim Anlegen eines Fahrzeugs.
model VehicleGroup {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  sortOrder        Int      @default(0)
  dailyRate        Decimal  @default(0) // Tagespreis
  workWeekRate     Decimal? // Woche, 5 Tage (Mo bis Fr)
  weeklyRate       Decimal? // Kalenderwoche, 7 Tage
  monthlyRate      Decimal? // Monat, 30 Tage
  kmIncludedPerDay Int      @default(200)
  extraKmRate      Decimal  @default(0.25)
  deposit          Decimal  @default(0)
  businessRules    Json? // abweichende Geschäftsregeln der Gruppe (nur gesetzte Schlüssel), null = Mandantenstandard
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bodyType             String  @default("PKW") // PKW | TRANSPORTER, bestimmt die Fallback-Skizze
  requiredLicenseClass String? // Phase 19.5: erforderliche Fahrerlaubnisklasse der Gruppe; null bei PKW = B, sonst konfigurieren
  sketchId             String? // eigene Skizze der Gruppe, sonst Fallback nach bodyType

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sketch             VehicleSketch?      @relation(fields: [sketchId], references: [id], onDelete: SetNull)
  vehicles           Vehicle[]
  checklistTemplates ChecklistTemplate[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

model Vehicle {
  id                   String    @id @default(cuid())
  tenantId             String
  plate                String
  make                 String
  model                String
  groupId              String?
  fuel                 String    @default("DIESEL") // DIESEL | BENZIN | ELEKTRO | HYBRID
  year                 Int?
  vin                  String?
  color                String?
  mileage              Int       @default(0)
  huDate               DateTime?
  requiredLicenseClass String? // Phase 19.5: erforderliche Fahrerlaubnisklasse (z. B. B); null = aus der Gruppe, PKW-Gruppe = B
  status               String    @default("AVAILABLE") // AVAILABLE | WORKSHOP | BLOCKED | INACTIVE
  dailyRate            Decimal   @default(0) // Tagespreis
  workWeekRate         Decimal? // Woche, 5 Tage (Mo bis Fr)
  weeklyRate           Decimal? // Kalenderwoche, 7 Tage
  monthlyRate          Decimal? // Monat, 30 Tage
  kmIncludedPerDay     Int       @default(200)
  extraKmRate          Decimal   @default(0.25)
  deposit              Decimal   @default(0)
  tankCapacityLiters   Int? // für die Berechnung von Tankfehlbeträgen
  businessRules        Json? // abweichende Geschäftsregeln des Fahrzeugs (nur gesetzte Schlüssel), null = Gruppe/Mandant
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group              VehicleGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  contracts          RentalContract[]
  handovers          Handover[]
  damages            Damage[]
  damageCases        DamageCase[]
  events             VehicleEvent[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
  documents          VehicleDocument[]
  authorityCases     AuthorityCase[]

  @@unique([tenantId, plate])
  @@index([tenantId, groupId])
  @@index([tenantId, status])
}

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  number            String? // Kundennummer, z. B. K-00001, fortlaufend je Mandant
  type              String    @default("PRIVATE") // PRIVATE | COMPANY
  companyName       String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  street            String?
  zip               String?
  city              String?
  country           String    @default("DE")
  birthDate         DateTime?
  birthPlace        String?
  nationality       String?
  idType            String? // PERSONALAUSWEIS | REISEPASS | AUFENTHALTSTITEL | SONSTIGES
  idNumber          String?
  idIssuedBy        String? // ausstellende Behörde
  idIssuedAt        DateTime?
  idValidUntil      DateTime?
  licenseNumber     String?
  licenseClass      String?
  licenseIssuedBy   String? // ausstellende Behörde
  licenseIssuedAt   DateTime?
  licenseValidUntil DateTime?
  blocked           Boolean   @default(false)
  blockReason       String?
  discountPercent   Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  contracts           RentalContract[]
  contractDrivers     ContractDriver[]
  invoices            Invoice[]
  payouts             Payout[]
  driverVerifications DriverVerification[]

  @@unique([tenantId, number])
  @@index([tenantId, lastName])
  @@index([tenantId, email])
}

model Booking {
  id             String    @id @default(cuid())
  tenantId       String
  number         String // z. B. 2026-0001, fortlaufend pro Mandant
  vehicleId      String
  customerId     String
  startAt        DateTime
  endAt          DateTime
  status         String    @default("RESERVED") // RESERVED | ACTIVE | RETURNED | CANCELLED
  dailyRate      Decimal   @default(0) // Preis-Snapshot bei Buchung
  workWeekRate   Decimal? // Snapshot Woche (5 Tage)
  weeklyRate     Decimal? // Snapshot Kalenderwoche (7 Tage)
  monthlyRate    Decimal? // Snapshot Monat (30 Tage)
  deposit        Decimal   @default(0)
  actualPickupAt DateTime? // gesetzt beim Finalisieren der Übergabe
  actualReturnAt DateTime? // gesetzt beim Finalisieren der Rückgabe
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  contract        RentalContract?
  handovers       Handover[]
  damages         Damage[]
  documents       Document[]
  invoices        Invoice[]
  extraCharges    ExtraCharge[]
  emailLogs       EmailLog[]
  vehicleEvents   VehicleEvent[]
  payments        Payment[]
  payouts         Payout[]
  securityDeposit SecurityDeposit?
  damageCases     DamageCase[]

  authorityCases       AuthorityCase[]
  driverVerifications  DriverVerification[]
  driverDocumentCopies DriverDocumentCopy[]

  @@unique([tenantId, number])
  @@index([tenantId, vehicleId, startAt, endAt])
  @@index([tenantId, status])
  @@index([tenantId, customerId, startAt])
}

// ============================================================================
// Etappe 2: Mietvertrag, Übergabe, Rückgabe, Schäden, Dokumente
// Grundsatz: Booking bleibt der Anker. Verträge und Protokolle sind versiegelte Kopien (Snapshots),
// keine Sicht auf Live-Daten. Zusätzlich schützen Datenbank-Trigger finalisierte Datensätze.
// ============================================================================

// Fahrzeugskizze für die Schadenkarte. Jede Version ist eine eigene, unveränderliche Zeile.
// tenantId = null: Systemskizze (Fallback "allgemeiner PKW" / "allgemeiner Transporter").
model VehicleSketch {
  id        String   @id @default(cuid())
  tenantId  String?
  code      String // GENERIC_PKW | GENERIC_TRANSPORTER | frei wählbar je Mandant
  name      String
  bodyType  String // PKW | TRANSPORTER
  version   Int      @default(1)
  assetPath String // Pfad unter /public oder Storage Key der SVG-Datei
  assetHash String // sha256 der Datei, damit die verwendete Fassung nachweisbar ist
  views     Json // [{ key, label, box }] Reihenfolge der Ansichten, box = Rahmen im Zeichenfeld
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups    VehicleGroup[]
  handovers Handover[]

  @@unique([tenantId, code, version])
  @@index([tenantId, bodyType, active])
}

// Mietvertrag, 1:1 zur Buchung. Alle Konditionen sind beim Anlegen kopiert und ab Unterschrift eingefroren.
model RentalContract {
  id         String @id @default(cuid())
  tenantId   String
  bookingId  String @unique
  number     String // z. B. MV-2026-0001
  status     String @default("DRAFT") // DRAFT | SIGNED | CANCELLED
  customerId String // Referenz, maßgeblich ist customerSnapshot
  vehicleId  String // Referenz, maßgeblich ist vehicleSnapshot

  customerSnapshot Json // Name, Adresse, Ausweis, Führerschein zum Vertragszeitpunkt
  vehicleSnapshot  Json // Kennzeichen, Marke, Modell, Gruppe, FIN, Antrieb zum Vertragszeitpunkt
  priceSnapshot    Json // verwendete Preisstufen, Berechnungsstrategie und Aufschlüsselung

  startAt           DateTime
  endAt             DateTime
  totalAmount       Decimal  @default(0)
  discountPercent   Int      @default(0)
  deposit           Decimal  @default(0)
  kmIncludedPerDay  Int      @default(0)
  extraKmRate       Decimal  @default(0)
  deductible        Decimal  @default(0) // Selbstbeteiligung
  fuelPolicy        String   @default("FULL_TO_FULL") // FULL_TO_FULL | SAME_LEVEL | INCLUDED | OTHER
  fuelPolicyNote    String? // Beschreibung bei OTHER
  fuelPricePerLiter Decimal? // Preis je fehlendem Liter inkl. Service
  agreedTotal       Decimal? // abweichend vereinbarter Gesamtmietpreis, sonst gilt die Berechnung
  agreedTotalNote   String?
  pickupLocation    String?
  returnLocation    String?
  internalNote      String? // nur intern, nicht Teil des unterschriebenen Inhalts
  driverMode        String   @default("RENTER") // RENTER = Mieter fährt selbst | OTHER = abweichender Fahrer
  wizardStep        Int      @default(1) // zuletzt erreichter Schritt im Assistenten
  conditions        Json? // weitere Konditionen, erweiterbar ohne Migration
  landlordSnapshot  Json? // Vermieterdaten (Name, Anschrift, Kontakt) zum Zeitpunkt des Abschlusses, für Dokumente

  termsVersion String? // Bezeichnung der Mietbedingungen-Fassung (Label der Version, bei Altverträgen freier Text)
  termsHash    String? // sha256 des Bedingungstextes (= Prüfsumme der Version)
  termsText    String? // eingefrorene Kopie der Mietbedingungen zum Vertragszeitpunkt
  contentHash  String? // sha256 über den unterschriebenen Vertragsinhalt

  // Phase 15: versionierte Mietbedingungen, Kenntnisnahme, individuelle Vereinbarungen. conditions = eingefrorene Geschäftsregeln.
  rentalTermsVersionId    String? // gewählte veröffentlichte Fassung; Altverträge ohne Versionierung: null
  termsFormat             String? // MARKDOWN | PLAIN (Altbestand); null bei Verträgen ohne Bedingungstext
  termsAcknowledgedAt     DateTime? // Kenntnisnahme der Fassung vor der Unterschrift
  termsAcknowledgedById   String?
  termsAcknowledgedByName String?
  termsAcknowledgedHash   String? // Fassung + Prüfsumme, auf die sich die Kenntnisnahme bezieht
  individualAgreements    String? // individuelle Vereinbarungen, Teil des unterschriebenen Inhalts

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  signedAt    DateTime?
  cancelledAt DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking    Booking           @relation(fields: [bookingId], references: [id])
  customer   Customer          @relation(fields: [customerId], references: [id])
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])
  drivers    ContractDriver[]
  handovers  Handover[]
  signatures Signature[]
  documents  Document[]
  invoices   Invoice[]
  deposits   SecurityDeposit[]

  authorityCases      AuthorityCase[]
  driverVerifications DriverVerification[]
  rentalTermsVersion  RentalTermsVersion?  @relation(fields: [rentalTermsVersionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, rentalTermsVersionId])
}

// Fahrer und Zusatzfahrer am Vertrag. Eigene Kopie der Daten, optionale Verbindung zu einem Kunden.
model ContractDriver {
  id         String  @id @default(cuid())
  tenantId   String
  contractId String
  customerId String? // nur Referenz; spätere Änderungen am Kunden wirken hier nicht
  role       String  @default("ADDITIONAL_DRIVER") // PRIMARY_DRIVER | ADDITIONAL_DRIVER

  firstName String
  lastName  String
  birthDate DateTime
  street    String
  zip       String
  city      String
  country   String   @default("DE")

  licenseNumber     String
  licenseClass      String
  licenseIssuedAt   DateTime
  licenseValidUntil DateTime?
  licenseCountry    String    @default("DE")
  licenseIssuedBy   String?

  createdAt DateTime @default(now())

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract       RentalContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  verifications  DriverVerification[]
  documentCopies DriverDocumentCopy[]

  @@index([tenantId, contractId])
  @@index([tenantId, customerId])
}

// Übergabe (PICKUP) und Rückgabe (RETURN) in einem Modell.
model Handover {
  id         String  @id @default(cuid())
  tenantId   String
  bookingId  String
  vehicleId  String
  contractId String?
  type       String // PICKUP | RETURN
  status     String  @default("DRAFT") // DRAFT | FINALIZED
  number     String // z. B. UP-2026-0001 (Übergabe), RP-2026-0001 (Rückgabe)

  employeeId   String?
  employeeName String // Kopie, falls der Benutzer später umbenannt oder entfernt wird

  mileage          Int?
  fuelLevelEighths Int? // 0 bis 8
  batteryPercent   Int? // 0 bis 100
  driveType        String // Kopie von Vehicle.fuel beim Start
  accessories      Json? // mitgegebenes oder zurückgegebenes Zubehör
  notes            String?

  sketchId        String?
  sketchVersion   Int?
  sketchAssetHash String? // genau diese Skizzenfassung wurde verwendet

  correctsId        String? // Nachtrag: verweist auf das ursprüngliche Protokoll
  wizardStep        Int      @default(1) // zuletzt erreichter Schritt im Assistenten
  fuelPricePerLiter Decimal? // nur Rückgabe: bei der Rückgabe ausdrücklich angegebener Literpreis, falls der Vertrag keinen nennt

  startedAt   DateTime  @default(now())
  finalizedAt DateTime?
  contentHash String? // sha256 über den versiegelten Inhalt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking     Booking         @relation(fields: [bookingId], references: [id])
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
  contract    RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  employee    User?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sketch      VehicleSketch?  @relation(fields: [sketchId], references: [id], onDelete: SetNull)
  corrects    Handover?       @relation("HandoverCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections Handover[]      @relation("HandoverCorrection")

  damages              HandoverDamage[]
  checklistItems       HandoverChecklistItem[]
  photos               Photo[]
  signatures           Signature[]
  documents            Document[]
  extraCharges         ExtraCharge[]
  discovered           Damage[]
  vehicleEvents        VehicleEvent[]
  invoices             Invoice[]
  damageCases          DamageCase[]
  driverVerifications  DriverVerification[]
  driverDocumentCopies DriverDocumentCopy[]

  @@unique([tenantId, number])
  @@index([tenantId, bookingId, type])
  @@index([tenantId, vehicleId, finalizedAt])
}

// Schadenakte des Fahrzeugs. Lebt weiter, wird nie gelöscht. Positionen normalisiert 0..1.
model Damage {
  id          String  @id @default(cuid())
  tenantId    String
  vehicleId   String
  view        String // LEFT | RIGHT | FRONT | REAR | TOP | INTERIOR
  posX        Float // 0..1, relativ zur Ansicht
  posY        Float // 0..1
  kind        String // SCRATCH | DENT | CRACK | CHIP | BROKEN | MISSING_PART | STAIN | OTHER
  description String
  size        String? // z. B. "ca. 12 cm"
  severity    String  @default("MINOR") // MINOR | MODERATE | SEVERE
  status      String  @default("OPEN") // OPEN | DOCUMENTED | REPAIR_PLANNED | IN_REPAIR | REPAIRED

  discoveredAt           DateTime  @default(now())
  discoveredInHandoverId String?
  bookingId              String? // Miete, in der der Schaden entstanden ist
  reportedById           String?
  repairedAt             DateTime?
  repairNote             String?
  settlementReview       Boolean   @default(false) // bei Rückgabe festgestellt: Schadenabrechnung ist intern zu prüfen (keine Haftungsfeststellung)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id])
  discoveredIn Handover?        @relation(fields: [discoveredInHandoverId], references: [id], onDelete: SetNull)
  booking      Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  snapshots    HandoverDamage[]
  photos       Photo[]
  extraCharges ExtraCharge[]
  events       VehicleEvent[]
  damageCase   DamageCase? // operative Schadenakte (Phase 12), genau eine je Schaden

  @@index([tenantId, vehicleId, status])
}

// Schaden im Protokoll: echte Kopie des damaligen Zustands, keine Sicht auf Damage.
model HandoverDamage {
  id         String  @id @default(cuid())
  tenantId   String
  handoverId String
  damageId   String? // nur Referenz zur Schadenakte
  marker     String // EXISTING | NEW

  view        String
  posX        Float
  posY        Float
  kind        String
  description String
  size        String?
  severity    String
  photoRefs   Json     @default("[]") // [{ photoId, storageKey, checksum }] zum Zeitpunkt des Protokolls
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  damage   Damage?  @relation(fields: [damageId], references: [id], onDelete: SetNull)
  photos   Photo[]

  @@index([tenantId, handoverId])
}

// Checklisten-Vorlage je Mandant, optional je Fahrzeuggruppe. Jede Version ist eine eigene Zeile.
model ChecklistTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String?
  handoverType String   @default("BOTH") // PICKUP | RETURN | BOTH
  name         String
  version      Int      @default(1)
  active       Boolean  @default(true)
  items        Json // [{ key, label, answerType, required }]
  createdAt    DateTime @default(now())

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  VehicleGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  used   HandoverChecklistItem[]

  @@unique([tenantId, name, version])
  @@index([tenantId, active])
}

// Tatsächlich verwendete Frage samt Antwort, als Kopie im Protokoll.
model HandoverChecklistItem {
  id              String  @id @default(cuid())
  tenantId        String
  handoverId      String
  templateId      String?
  templateVersion Int?
  itemKey         String
  label           String
  answerType      String  @default("OK_NOT_OK") // OK_NOT_OK | YES_NO | TEXT
  required        Boolean @default(true)
  result          String? // OK | NOT_OK | YES | NO | Freitext
  note            String?
  sortOrder       Int     @default(0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover           @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
}

// Foto im privaten Object Storage. Es wird nur der Storage Key gespeichert, nie eine öffentliche URL.
model Photo {
  id               String    @id @default(cuid())
  tenantId         String
  handoverId       String?
  damageId         String?
  handoverDamageId String?
  damageCaseId     String? // zusätzliche Fotos zur Schadenakte (Detail, Werkstatt, nach Reparatur)
  caption          String? // kurze Beschreibung, z. B. "Werkstattaufnahme"
  storageKey       String    @unique
  category         String // FRONT | REAR | LEFT | RIGHT | INTERIOR | ODOMETER | FUEL | DAMAGE | DOCUMENT | OTHER
  contentType      String
  sizeBytes        Int
  checksum         String // sha256
  width            Int?
  height           Int?
  takenAt          DateTime?
  uploadedAt       DateTime  @default(now())
  createdById      String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover       Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  damage         Damage?         @relation(fields: [damageId], references: [id], onDelete: SetNull)
  handoverDamage HandoverDamage? @relation(fields: [handoverDamageId], references: [id], onDelete: SetNull)
  damageCase     DamageCase?     @relation(fields: [damageCaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
  @@index([tenantId, damageId])
  @@index([tenantId, damageCaseId])
}

// Unterschrift, gebunden an genau den Inhalt (contentHash), der unterschrieben wurde.
model Signature {
  id            String   @id @default(cuid())
  tenantId      String
  handoverId    String?
  contractId    String?
  role          String // RENTER | EMPLOYEE
  signerName    String
  storageKey    String   @unique // vorgesehener Ort im Object Storage
  imageData     Bytes? // PNG der Unterschrift; liegt in der Datenbank, bis der Object Storage angebunden ist
  imageChecksum String? // sha256 des Bildes
  contentHash   String // Hash des unterschriebenen Inhalts
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  createdById   String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  contract RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
  @@index([tenantId, contractId])
}

// Erzeugtes Dokument (PDF). Unveränderlich archiviert: einmal erzeugt, nie überschrieben.
model Document {
  id               String   @id @default(cuid())
  tenantId         String
  bookingId        String
  contractId       String?
  handoverId       String?
  invoiceId        String?
  invoiceVersionId String? // Rechnungsfassung, aus der das PDF entstand
  payoutId         String? // Auszahlung (Phase 18): Auszahlungsbeleg (PAYOUT_RECEIPT) oder hochgeladener Nachweis (PAYOUT_ATTACHMENT)
  type             String // RENTAL_CONTRACT | PICKUP_PROTOCOL | RETURN_PROTOCOL | INVOICE | CREDIT_NOTE | CANCELLATION | PAYOUT_RECEIPT | PAYOUT_ATTACHMENT
  storageKey       String   @unique
  fileName         String
  contentType      String   @default("application/pdf")
  sizeBytes        Int
  checksum         String // sha256 der gespeicherten Datei
  sourceHash       String? // Prüfsumme (contentHash) des versiegelten Vertrags oder Protokolls, aus dem das PDF entstand
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  createdById      String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking         @relation(fields: [bookingId], references: [id])
  contract       RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  handover       Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceVersion InvoiceVersion? @relation(fields: [invoiceVersionId], references: [id], onDelete: SetNull)
  payout         Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookingId, type])
  @@index([tenantId, payoutId])
}

// Zusatzkosten mit vollständiger Rechengrundlage, z. B. 342 km × 0,25 € = 85,50 €.
model ExtraCharge {
  id               String   @id @default(cuid())
  tenantId         String
  bookingId        String
  handoverId       String?
  damageId         String?
  type             String // EXTRA_MILEAGE | FUEL | CHARGING | CLEANING | LATE_RETURN | MISSING_ACCESSORY | DAMAGE | OTHER
  description      String
  quantity         Decimal
  unit             String // km, l, kWh, h, Stk, pauschal
  unitPrice        Decimal
  amount           Decimal
  formula          String // lesbare Rechnung
  calculation      Json // Eingangswerte der Rechnung
  source           String   @default("MANUAL") // PROPOSAL = vom System vorgeschlagen und vom Mitarbeiter bestätigt | MANUAL = frei erfasst
  internalNote     String? // nur intern, nicht auf Dokumenten
  handoverDamageId String? // Bezug zum im Protokoll erfassten Schaden (bis zum Abschluss gibt es noch keine Schadenakte)
  createdAt        DateTime @default(now())
  createdById      String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id])
  handover     Handover?     @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  damage       Damage?       @relation(fields: [damageId], references: [id], onDelete: SetNull)
  invoiceItems InvoiceItem[]

  @@index([tenantId, bookingId])
}

// Protokoll jedes Mailversuchs. Ein Fehler hier macht nie eine Übergabe oder Rückgabe rückgängig.
model EmailLog {
  id                String    @id @default(cuid())
  tenantId          String
  bookingId         String?
  recipient         String
  subject           String
  template          String // z. B. PICKUP_PROTOCOL
  attachments       Json      @default("[]") // [{ documentId, fileName, checksum }]
  status            String    @default("PENDING") // PENDING | SENT | FAILED
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  idempotencyKey    String
  handoverId        String? // Bezug zum Protokoll, nur Referenz
  invoiceId         String? // Bezug zur Rechnung, nur Referenz
  invoiceVersionId  String? // welche Rechnungsfassung versendet wurde (Anhang = deren PDF)
  payoutId          String? // Auszahlungsbeleg (Phase 18), nur Referenz
  trigger           String    @default("AUTO") // AUTO = nach Abschluss | MANUAL = "erneut senden"
  attemptNo         Int       @default(1) // fortlaufender Versuch je Buchung und Vorlage
  createdById       String?
  createdAt         DateTime  @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceVersion InvoiceVersion? @relation(fields: [invoiceVersionId], references: [id], onDelete: SetNull)
  payout         Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, bookingId, createdAt])
  @@index([tenantId, invoiceVersionId])
  @@index([tenantId, payoutId])
}

// Fahrzeughistorie, nur anfügen.
model VehicleEvent {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  type        String // PICKUP | RETURN | MILEAGE | DAMAGE_DISCOVERED | DAMAGE_REPAIRED
  occurredAt  DateTime @default(now())
  mileage     Int?
  bookingId   String?
  damageId    String?
  handoverId  String?
  userId      String?
  userName    String?
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  damage   Damage?   @relation(fields: [damageId], references: [id], onDelete: SetNull)
  handover Handover? @relation(fields: [handoverId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId, occurredAt])
}

// Rechnung. Beträge, Empfänger und Firmendaten sind ab dem Abschluss versiegelte Kopien; nichts wird beim
// Anzeigen aus Buchung, Vertrag oder Zusatzkosten neu berechnet. Die Nummer wird erst beim Abschluss vergeben.
model Invoice {
  id                String  @id @default(cuid())
  tenantId          String
  bookingId         String
  customerId        String? // nur Referenz, maßgeblich ist customerSnapshot
  contractId        String? // Vertrag, aus dem der Mietpreis stammt
  returnHandoverId  String? // Rückgabe, aus der die bestätigten Zusatzkosten stammen
  number            String? // z. B. RE-2026-000001, erst beim Abschluss vergeben
  status            String  @default("DRAFT") // DRAFT | FINALIZED (CANCELLED / CREDITED werden nicht gespeichert, sondern aus der Belegkette abgeleitet)
  // Phase 12: Rechnungsart. RENTAL = Mietrechnung (höchstens eine abgeschlossene je Buchung), DAMAGE = Schadenabrechnung zu einer Schadenakte
  kind              String  @default("RENTAL")
  // Phase 17: Belegart. INVOICE = Rechnung; CREDIT_NOTE = Gutschrift (Teil oder voll) und CANCELLATION = Stornobeleg sind eigene
  // Gegenbelege mit eigener Nummer, positiven Beträgen und Wirkung CREDIT (Minderung) auf genau eine abgeschlossene Originalrechnung.
  // "kind" bleibt die Herkunft (RENTAL/DAMAGE) und wird vom Original übernommen.
  documentType      String  @default("INVOICE")
  originalInvoiceId String? // nur Gegenbeleg: die Originalrechnung (nie ein anderer Gegenbeleg)
  originalVersionId String? // nur Gegenbeleg: die Fassung des Originals, auf der der Beleg beruht (muss beim Abschluss die aktuelle sein)
  originalSnapshot  Json? // nur Gegenbeleg: Nummer, Datum, Fassung, Empfänger, Leistungszeitraum, Betrag des Originals (unveränderlich)
  damageCaseId      String? // nur DAMAGE: die Schadenakte, deren Kundenbelastung abgerechnet wird
  damageId          String? // nur DAMAGE: der zugrunde liegende Fahrzeugschaden (Referenz)
  taxTreatment      String? // nur DAMAGE: bei Anlage gewählte Behandlung NON_TAXABLE_DAMAGE_COMPENSATION | TAXABLE_SUPPLY; maßgeblich ist der Wert der jeweiligen Fassung (InvoiceVersion.taxTreatment)

  // Phase 10: Die Rechnungsdaten liegen in unveränderlichen Fassungen (InvoiceVersion). Invoice ist nur noch die
  // logische Rechnung: Nummer, Bezug, Zeiger auf die aktuelle Fassung, interne Notiz, Änderungsprotokoll, Exportmarke.
  // Die folgenden Spalten sind Altbestand aus Phase 8/9 (Fassung 1 wurde daraus kopiert) und werden nicht mehr beschrieben.
  issueDate          DateTime? // Rechnungsdatum der Fassung 1 (Altbestand)
  servicePeriodStart DateTime? // Altbestand
  servicePeriodEnd   DateTime? // Altbestand
  currency           String    @default("EUR")
  pricesIncludeTax   Boolean? // Altbestand
  customerSnapshot   Json? // Altbestand
  companySnapshot    Json? // Altbestand
  netTotal           Decimal   @default(0) // Altbestand
  taxTotal           Decimal   @default(0) // Altbestand
  grossTotal         Decimal   @default(0) // Altbestand
  paymentTermDays    Int? // Altbestand
  paymentDueDate     DateTime? // Altbestand
  customerNote       String? // Altbestand
  taxNote            String? // Altbestand
  contentHash        String? // Altbestand (Prüfsumme der Fassung 1)
  version            Int       @default(1) // Altbestand

  notes     String? // nur intern, nie auf Dokumenten
  changeLog Json    @default("[]") // [{ at, by, summary, versionNo? }] Änderungen an Entwürfen und Fassungen

  sourceHash       String? // Prüfsummen der Quellen (Vertrag, Rückgabe) beim Erstellen
  currentVersionId String?   @unique // aktuell gültige abgeschlossene Fassung
  exportedAt       DateTime? // buchhalterisch exportiert: danach keine Fassung mehr unter dieser Nummer
  exportBatchId    String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime? // Abschluss der Fassung 1

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking          Booking          @relation(fields: [bookingId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract         RentalContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  returnHandover   Handover?        @relation(fields: [returnHandoverId], references: [id], onDelete: SetNull)
  items            InvoiceItem[] // Altbestand (Positionen der Fassung 1 vor Phase 10)
  documents        Document[]
  payments         Payment[]
  payouts          Payout[]
  versions         InvoiceVersion[] @relation("InvoiceVersions")
  currentVersion   InvoiceVersion?  @relation("InvoiceCurrentVersion", fields: [currentVersionId], references: [id])
  damageCase       DamageCase?      @relation(fields: [damageCaseId], references: [id])
  authorityCaseId  String? // nur AUTHORITY_FEE: Behördenvorgang, dessen Bearbeitungsentgelt laut Mietvertrag berechnet wird
  authorityCase    AuthorityCase?   @relation(fields: [authorityCaseId], references: [id])
  original         Invoice?         @relation("InvoiceCounterDocuments", fields: [originalInvoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  counterDocuments Invoice[]        @relation("InvoiceCounterDocuments")
  originalVersion  InvoiceVersion?  @relation("InvoiceOriginalVersion", fields: [originalVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, number])
  @@index([tenantId, bookingId])
  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([tenantId, originalInvoiceId])
  @@index([tenantId, customerId])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  sortOrder     Int      @default(0)
  description   String
  quantity      Decimal
  unit          String
  unitPrice     Decimal // je Einheit; brutto oder netto laut Invoice.pricesIncludeTax
  netAmount     Decimal
  taxRate       Decimal // Prozent, z. B. 19.00
  taxAmount     Decimal
  grossAmount   Decimal
  source        String // RENTAL | EXTRA_CHARGE | MANUAL
  extraChargeId String?
  reference     String? // interne Referenz, z. B. Vertragsnummer oder Formel
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  extraCharge ExtraCharge? @relation(fields: [extraChargeId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
}

// ============================================================================
// Phase 9: Zahlungen und Kaution. Drei getrennte Fachbereiche:
//   Invoice = Forderung, Payment = dokumentierter Geldfluss, SecurityDeposit = Sicherheitsleistung.
// Nichts davon wird automatisch miteinander verrechnet. Beträge sind ganze Cent (money.ts).
// Bestätigte Zahlungen und Kautionsbewegungen werden nie gelöscht, nur mit Grund storniert (DB-Trigger).
// ============================================================================

model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  bookingId      String
  invoiceId      String? // bei INVOICE_PAYMENT Pflicht (Trigger), sonst leer
  type           String // INVOICE_PAYMENT | OTHER_PAYMENT
  method         String // CASH | CARD | BANK_TRANSFER | OTHER; CARD/BANK_TRANSFER = außerhalb von Rent-Base ausgeführt, hier nur dokumentiert
  amountCents    Int
  currency       String   @default("EUR")
  status         String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  paidAt         DateTime
  reference      String? // z. B. Belegnummer, Verwendungszweck
  note           String?
  idempotencyKey String? // einmaliger Formularschlüssel gegen Doppelbuchung
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancellationReason String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking  @relation(fields: [bookingId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, bookingId])
  @@index([tenantId, paidAt])
}

// Kaution je Buchung. Der vereinbarte Betrag stammt aus dem abgeschlossenen Mietvertrag und ändert sich danach nicht.
// Erhalten, freigegeben und einbehalten ergeben sich ausschließlich aus den bestätigten Bewegungen; der Status
// wird in derselben Transaktion daraus abgeleitet (EXPECTED | RECEIVED | PARTIALLY_RELEASED | RELEASED | RETAINED).
model SecurityDeposit {
  id                  String   @id @default(cuid())
  tenantId            String
  bookingId           String   @unique
  contractId          String?
  expectedAmountCents Int
  currency            String   @default("EUR")
  status              String   @default("EXPECTED")
  note                String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking                @relation(fields: [bookingId], references: [id])
  contract RentalContract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  events   SecurityDepositEvent[]
  payouts  Payout[]

  @@index([tenantId, status])
}

// Eine Bewegung der Kaution. Bestätigte Bewegungen sind unveränderlich; eine Korrektur ist ein Storno mit Grund
// (status CANCELLED), die ursprüngliche Zeile bleibt sichtbar.
model SecurityDepositEvent {
  id             String   @id @default(cuid())
  tenantId       String
  depositId      String
  type           String // RECEIVED | RELEASED | RETAINED
  amountCents    Int
  method         String? // CASH | CARD | BANK_TRANSFER | OTHER (bei RECEIVED und RELEASED)
  reference      String?
  reason         String? // Pflicht bei RETAINED
  note           String?
  occurredAt     DateTime
  status         String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  idempotencyKey String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancellationReason String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deposit SecurityDeposit @relation(fields: [depositId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, depositId, status])
}

// Phase 18: Auszahlung = tatsächlicher Geldabfluss an den Kunden (Rechnungserstattung oder Kautionsrückzahlung).
// Vier Dinge bleiben getrennt: Forderung (Invoice), Zahlung (Payment, Geld rein), Guthaben/Freigabe (abgeleitet bzw.
// SecurityDepositEvent RELEASED) und Auszahlung (Payout, Geld raus). Nur COMPLETED zählt finanziell. Rent-Base führt
// keine Überweisung, Karten- oder Providertransaktion aus; es dokumentiert den Vorgang und erzeugt einen Nachweis.
model Payout {
  id                String    @id @default(cuid())
  tenantId          String
  number            String? // AZ-JJJJ-NNNNNN, erst beim Abschluss (COMPLETED) vergeben
  sourceType        String // INVOICE_REFUND | SECURITY_DEPOSIT_REFUND
  invoiceId         String? // genau eine Quelle: Rechnung ...
  securityDepositId String? // ... oder Kaution
  bookingId         String
  customerId        String?
  status            String    @default("DRAFT") // DRAFT | COMPLETED | CANCELLED
  amountCents       Int
  currency          String    @default("EUR")
  method            String // BANK_TRANSFER | CASH | CARD | OTHER
  methodDescription String? // Pflicht bei OTHER: wie wurde ausgezahlt
  executedAt        DateTime? // tatsächlicher Zeitpunkt der Auszahlung (Pflicht bei COMPLETED)
  plannedAt         DateTime? // geplanter Zeitpunkt im Entwurf (optional)

  // Empfänger-Snapshot: Standard = Kunde aus Rechnung/Kaution; abweichender Empfänger nur mit Grund. Nie Stammdaten ändern.
  recipientName     String
  recipientDeviates Boolean @default(false)
  recipientReason   String?
  iban              String? // nur BANK_TRANSFER, nur an dieser Auszahlung (keine dauerhafte Bankverbindung)
  ibanMasked        String? // z. B. DE** **** **** **** **12 34 – für Anzeige, PDF und Protokoll
  reference         String? // Verwendungszweck, Transaktions-/Belegnummer (generisch)
  receiptConfirmed  Boolean @default(false) // Barauszahlung: Empfang vom Empfänger bestätigt
  historicalEntry   Boolean @default(false) // nachträglich dokumentiert (Auszahlung erfolgte außerhalb von Rent-Base, vor der Erfassung)
  customerNote      String? // Text auf dem Auszahlungsbeleg
  internalNote      String? // nur intern, nie auf dem Beleg

  sourceSnapshot Json? // Stand der Quelle beim Abschluss (Nummern, Forderung, Zahlungen, Guthaben, bereits ausgezahlt)
  contentHash    String? // sha256 über den versiegelten Inhalt (beim Abschluss)
  idempotencyKey String? // einmaliger Formularschlüssel gegen Doppelbuchung

  createdById     String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  completedById   String?
  completedByName String?

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancellationReason String?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking          @relation(fields: [bookingId], references: [id])
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id])
  deposit   SecurityDeposit? @relation(fields: [securityDepositId], references: [id])
  customer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  documents Document[]
  emailLogs EmailLog[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, securityDepositId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, bookingId])
}

// Protokoll kritischer Geldaktionen. Keine Kundendaten, nur Bezug, Betrag, Aktion, Benutzer, Zeitpunkt.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  action      String // PAYMENT_RECORDED | PAYMENT_CANCELLED | DEPOSIT_RECEIVED | DEPOSIT_RELEASED | DEPOSIT_PARTIALLY_RELEASED | DEPOSIT_RETAINED | DEPOSIT_CORRECTION
  bookingId   String?
  invoiceId   String?
  paymentId   String?
  depositId   String?
  amountCents Int?
  details     Json?
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, bookingId])
}

// ============================================================================
// Phase 10: Rechnungsfassungen. Invoice = logische Rechnung (Nummer bleibt), InvoiceVersion = unveränderliche Fassung.
// Jede erneute Finalisierung erzeugt eine neue Fassung aus dem Snapshot der vorherigen; nichts wird überschrieben.
// "Ersetzt" ist kein gespeicherter Status, sondern folgt aus Invoice.currentVersionId (versiegelter Inhalt bleibt unberührt).
// ============================================================================

model InvoiceVersion {
  id                  String  @id @default(cuid())
  tenantId            String
  invoiceId           String
  versionNo           Int
  kind                String // ORIGINAL | REVISION (Vorfassung nie übermittelt) | CORRECTION (Vorfassung bereits übermittelt)
  status              String  @default("DRAFT") // DRAFT | FINALIZED
  supersedesVersionId String? // Vorfassung, aus deren Snapshot dieser Entwurf entstand
  reason              String? // Grund (Pflicht bei CORRECTION); erscheint auf der berichtigten Rechnung

  issueDate          DateTime? // Rechnungsdatum (bei Fassung 1 vergeben, danach übernommen)
  correctionDate     DateTime? // Datum der Berichtigung/Neufassung (Fassung >= 2)
  servicePeriodStart DateTime
  servicePeriodEnd   DateTime
  currency           String    @default("EUR")
  pricesIncludeTax   Boolean

  customerSnapshot Json
  companySnapshot  Json

  netTotal   Decimal @default(0)
  taxTotal   Decimal @default(0)
  grossTotal Decimal @default(0)

  paymentTermDays Int?
  paymentDueDate  DateTime?
  customerNote    String?
  taxNote         String?
  // Steuerliche Behandlung der Fassung (nur Schadenabrechnung): NON_TAXABLE_DAMAGE_COMPENSATION (echter Schadensersatz, nicht steuerbar, kein USt-Ausweis) | TAXABLE_SUPPLY (steuerpflichtiges Entgelt). Versiegelter Bestandteil der Fassung.
  taxTreatment    String?

  contentHash      String? // sha256 über den versiegelten Inhalt dieser Fassung
  diffFromPrevious Json? // strukturierte Differenz zur Vorfassung (beim Abschluss erzeugt)

  // Übermittlung außerhalb des Rent-Base-E-Mail-Versands (manuell bestätigt), hängt an der konkreten Fassung
  deliveredAt     DateTime?
  deliveredById   String?
  deliveredByName String?
  deliveredNote   String?

  exportedAt    DateTime? // buchhalterisch exportiert (Vorbereitung, kein Export in dieser Phase)
  exportBatchId String?

  createdById     String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finalizedAt     DateTime?
  finalizedById   String?
  finalizedByName String?

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          Invoice              @relation("InvoiceVersions", fields: [invoiceId], references: [id])
  currentOf        Invoice?             @relation("InvoiceCurrentVersion")
  items            InvoiceVersionItem[]
  documents        Document[]
  emailLogs        EmailLog[]
  counterDocuments Invoice[]            @relation("InvoiceOriginalVersion")

  @@unique([invoiceId, versionNo])
  @@index([tenantId, invoiceId, status])
}

model InvoiceVersionItem {
  id                         String   @id @default(cuid())
  tenantId                   String
  versionId                  String
  sortOrder                  Int      @default(0)
  description                String
  quantity                   Decimal
  unit                       String
  unitPrice                  Decimal
  netAmount                  Decimal
  taxRate                    Decimal
  taxAmount                  Decimal
  grossAmount                Decimal
  source                     String // RENTAL | EXTRA_CHARGE | MANUAL
  extraChargeId              String? // nur Referenz auf die Quelle der Fassung 1
  reference                  String? // Bezug; bei manuellen Gutschriftpositionen der Grund
  // Phase 17: nur Positionen eines Gegenbelegs: die Position der Originalfassung, die (teilweise) gutgeschrieben oder storniert wird
  sourceInvoiceVersionItemId String?
  createdAt                  DateTime @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version    InvoiceVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceItem InvoiceVersionItem?  @relation("CreditedItem", fields: [sourceInvoiceVersionItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creditedBy InvoiceVersionItem[] @relation("CreditedItem")

  @@index([tenantId, versionId])
  @@index([sourceInvoiceVersionItemId])
}

// ============================================================================
// Phase 12: Schadenmanagement. Damage bleibt die objektive Schadensinformation (Übergabe, Rückgabe, Skizze, Historie).
// DamageCase ist die operative Schadenakte: Prüfung, Haftung, Kosten, Reparatur, Dokumente, Kundenbelastung, Abschluss.
// Fahrzeugschaden ≠ Haftung ≠ Kundenforderung ≠ Rechnung ≠ Zahlung ≠ Kaution: jeder Übergang ist eine bewusste Entscheidung.
// ============================================================================

model DamageCase {
  id               String  @id @default(cuid())
  tenantId         String
  damageId         String  @unique // genau eine Akte je Schaden
  vehicleId        String
  bookingId        String?
  returnHandoverId String?
  caseNumber       String // SCH-2026-000001
  status           String  @default("OPEN") // OPEN | UNDER_REVIEW | REPAIR_PLANNED | IN_REPAIR | REPAIRED | CLOSED
  priority         String  @default("NORMAL") // LOW | NORMAL | HIGH
  liabilityStatus  String  @default("UNASSESSED") // UNASSESSED | UNCLEAR | CUSTOMER_RESPONSIBILITY_CONFIRMED | NOT_CUSTOMER_RESPONSIBILITY | THIRD_PARTY | INTERNAL
  liabilityNote    String? // Begründung der letzten Haftungsentscheidung

  reportedAt     DateTime
  reportedById   String?
  reportedByName String?
  description    String // Kopie der Schadensbeschreibung bei Eröffnung (Damage bleibt die Quelle)
  internalNote   String? // nie kundensichtbar

  estimatedCostCents  Int?
  actualCostCents     Int?
  currency            String    @default("EUR")
  repairProviderName  String?
  repairAppointmentAt DateTime?
  repairCompletedAt   DateTime?

  // Kundenbelastung (einmalig je Akte, bewusst festgelegt; erzeugt die Schadenabrechnung)
  customerChargeCents        Int?
  customerChargeBasis        String? // sachliche Grundlage, erscheint auf der Abrechnung
  customerChargeTaxTreatment String? // NON_TAXABLE_DAMAGE_COMPENSATION | TAXABLE_SUPPLY
  customerChargeAt           DateTime?
  customerChargeByName       String?

  closedAt     DateTime?
  closedById   String?
  closedByName String?
  closeReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  damage             Damage               @relation(fields: [damageId], references: [id])
  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id])
  booking            Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  returnHandover     Handover?            @relation(fields: [returnHandoverId], references: [id], onDelete: SetNull)
  events             DamageCaseEvent[]
  documents          DamageCaseDocument[]
  photos             Photo[]
  invoices           Invoice[]
  maintenanceRecords MaintenanceRecord[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, liabilityStatus])
  @@index([tenantId, vehicleId])
  @@index([tenantId, bookingId])
}

// Historie der Akte, nur anfügen.
model DamageCaseEvent {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  type      String // CREATED | STATUS_CHANGED | LIABILITY_CHANGED | COST_CHANGED | REPAIR_CHANGED | PHOTO_ADDED | DOCUMENT_ADDED | NOTE_ADDED | VEHICLE_BLOCKED | VEHICLE_RELEASED | CUSTOMER_CHARGE_CREATED | INVOICE_CREATED | CLOSED | REOPENED
  fromValue String?
  toValue   String?
  reason    String?
  note      String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   DamageCase @relation(fields: [caseId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

// Dokumente zur Akte (Kostenvoranschlag, Werkstattrechnung, Sonstiges), privat gespeichert, nur anfügen.
model DamageCaseDocument {
  id            String   @id @default(cuid())
  tenantId      String
  caseId        String
  type          String // ESTIMATE | REPAIR_INVOICE | OTHER
  fileName      String
  storageKey    String   @unique
  contentType   String
  sizeBytes     Int
  checksum      String
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case             DamageCase                @relation(fields: [caseId], references: [id])
  maintenanceLinks MaintenanceDocumentLink[]

  @@index([tenantId, caseId])
}

// ============================================================================
// Phase 13: Flotten-, Wartungs- und Fahrzeugaktenmanagement. Ein Wartungsvorgang (MaintenanceRecord) ist ein konkreter
// Werkstatt-/Servicevorgang am Fahrzeug; ein Wartungsplan (MaintenancePlan) beschreibt wiederkehrende Fälligkeiten nach
// Datum und/oder Kilometern. Kosten sind interne Betriebskosten – nie Kundenrechnung, Zahlung, Zusatzkosten oder Kaution.
// Der Warnstand (ok / bald fällig / fällig / überfällig) wird berechnet, nie gespeichert.
// ============================================================================

model MaintenancePlan {
  id                      String    @id @default(cuid())
  tenantId                String
  vehicleId               String
  type                    String // INSPECTION | OIL_SERVICE | HU_AU | TIRES | BRAKES | REPAIR | DAMAGE_REPAIR | AIR_CONDITIONING | OTHER
  title                   String
  intervalMonths          Int?
  intervalKilometers      Int?
  nextDueDate             DateTime?
  nextDueMileage          Int?
  warningDaysBefore       Int       @default(30)
  warningKilometersBefore Int       @default(1000)
  isActive                Boolean   @default(true)
  lastMaintenanceId       String?
  note                    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  lastMaintenance MaintenanceRecord?  @relation("PlanLastMaintenance", fields: [lastMaintenanceId], references: [id], onDelete: SetNull)
  records         MaintenanceRecord[] @relation("PlanRecords")

  @@index([tenantId, vehicleId])
  @@index([tenantId, isActive])
}

model MaintenanceRecord {
  id                 String    @id @default(cuid())
  tenantId           String
  vehicleId          String
  planId             String?
  damageCaseId       String? // nur bei DAMAGE_REPAIR (oder bewusst verknüpft): Schadenakte desselben Fahrzeugs
  maintenanceNumber  String // WA-2026-000001
  type               String
  status             String    @default("PLANNED") // PLANNED | SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  priority           String    @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  title              String
  description        String?
  workshopName       String?
  workshopContact    String? // Ansprechpartner / Telefon / E-Mail als Freitext, keine Lieferantenverwaltung
  scheduledAt        DateTime?
  scheduledEndAt     DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  mileageAtService   Int?
  estimatedCostCents Int?
  actualCostCents    Int?
  currency           String    @default("EUR")
  workDone           String? // Beschreibung der ausgeführten Arbeiten beim Abschluss
  nextDueDate        DateTime?
  nextDueMileage     Int?
  internalNote       String?
  cancelReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  createdByName      String?
  completedById      String?
  completedByName    String?

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle       Vehicle                   @relation(fields: [vehicleId], references: [id])
  plan          MaintenancePlan?          @relation("PlanRecords", fields: [planId], references: [id], onDelete: SetNull)
  damageCase    DamageCase?               @relation(fields: [damageCaseId], references: [id], onDelete: SetNull)
  planAsLast    MaintenancePlan[]         @relation("PlanLastMaintenance")
  events        MaintenanceEvent[]
  documents     VehicleDocument[]
  documentLinks MaintenanceDocumentLink[]

  @@unique([tenantId, maintenanceNumber])
  @@index([tenantId, vehicleId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, damageCaseId])
}

// Historie eines Wartungsvorgangs, nur anfügen.
model MaintenanceEvent {
  id            String   @id @default(cuid())
  tenantId      String
  maintenanceId String
  type          String // CREATED | UPDATED | SCHEDULED | STARTED | COMPLETED | CANCELLED | COST_CHANGED | DOCUMENT_ADDED | DOCUMENT_LINKED | DOCUMENT_ARCHIVED | DAMAGE_LINKED | NOTE_ADDED | VEHICLE_BLOCKED | VEHICLE_RELEASED
  fromValue     String?
  toValue       String?
  note          String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenance MaintenanceRecord @relation(fields: [maintenanceId], references: [id])

  @@index([tenantId, maintenanceId, createdAt])
}

// Dokumente der Fahrzeugakte: allgemeine Fahrzeugunterlagen und Belege zu Wartungsvorgängen. Privat gespeichert.
// Nie physisch gelöscht: eine Korrektur ist eine Archivierung mit Grund (Datei und Zeile bleiben erhalten).
model VehicleDocument {
  id             String    @id @default(cuid())
  tenantId       String
  vehicleId      String
  maintenanceId  String?
  type           String // REGISTRATION | INSURANCE | HU_REPORT | INSPECTION_REPORT | WORKSHOP_INVOICE | ESTIMATE | REPAIR_REPORT | TIRE_DOCUMENT | OTHER
  fileName       String
  storageKey     String    @unique
  contentType    String
  sizeBytes      Int
  checksum       String
  documentDate   DateTime?
  description    String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?
  archivedById   String?
  archivedByName String?
  archiveReason  String?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id])
  maintenance MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId])
  @@index([tenantId, maintenanceId])
}

// Verknüpfung eines bereits in der Schadenakte liegenden Dokuments mit einem Wartungsvorgang – dieselbe Datei, keine Kopie.
model MaintenanceDocumentLink {
  id                   String   @id @default(cuid())
  tenantId             String
  maintenanceId        String
  damageCaseDocumentId String
  createdById          String?
  createdByName        String?
  createdAt            DateTime @default(now())

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenance        MaintenanceRecord  @relation(fields: [maintenanceId], references: [id])
  damageCaseDocument DamageCaseDocument @relation(fields: [damageCaseDocumentId], references: [id])

  @@unique([maintenanceId, damageCaseDocumentId])
  @@index([tenantId, maintenanceId])
}

// ============================================================================
// Phase 14: Bußgelder, Verkehrsverstöße und Behördenanfragen. Ein AuthorityCase ist ein Behördenvorgang zu einem
// Kennzeichen/Tatzeitpunkt. Harte Regeln: Vertraglicher Fahrer ≠ nachgewiesener Fahrzeugführer – Rent-Base stellt nur
// „Tatzeit innerhalb der Mietdauer“ und „vertraglicher Haupt-/Zusatzfahrer“ fest; die Fahrerbestimmung, die Antwort und
// die Übermittlung sind ausdrückliche Entscheidungen eines berechtigten Mitarbeiters. Freigegebene Antworten sind
// unveränderliche Fassungen. Kein Bußgeld erzeugt eine Rechnung, Zahlung, Zusatzkosten oder Kautionsbewegung.
// ============================================================================

model AuthorityCase {
  id                        String    @id @default(cuid())
  tenantId                  String
  caseNumber                String // BH-2026-000001
  type                      String // SPEEDING | PARKING | RED_LIGHT | TOLL | TRAFFIC_VIOLATION | DRIVER_IDENTIFICATION | AUTHORITY_REQUEST | OTHER
  status                    String    @default("RECEIVED") // RECEIVED | ASSIGNMENT_REQUIRED | REVIEW_REQUIRED | RESPONSE_PREPARED | READY_TO_SEND | SUBMITTED | CLOSED | CANCELLED
  authorityName             String
  authorityDepartment       String?
  authorityReference        String // behördliches Aktenzeichen, bleibt getrennt von caseNumber
  authorityAddress          String? // Postanschrift laut Schreiben (Freitext)
  authorityEmail            String? // nur wenn im Schreiben ausdrücklich genannt oder bewusst erfasst
  authorityPortalUrl        String? // Portaladresse laut Schreiben; Zugangsdaten werden nicht gespeichert
  offenseType               String?
  offenseDescription        String?
  offenseAt                 DateTime // bei unbekannter Uhrzeit: 12:00 Europe/Berlin des Tattags, siehe offenseTimeKnown
  offenseTimeKnown          Boolean   @default(true)
  offenseLocation           String?
  licensePlateSnapshot      String // Kennzeichen exakt wie im Schreiben
  licensePlateNormalized    String // Vergleichsschlüssel (nur Buchstaben/Ziffern, groß)
  vehicleId                 String?
  bookingId                 String?
  contractId                String?
  vehicleMatch              String    @default("UNMATCHED") // UNMATCHED | EXACT_MATCH | NO_MATCH | AMBIGUOUS | MANUALLY_ASSIGNED
  rentalMatch               String    @default("UNMATCHED") // UNMATCHED | ACTUAL_PERIOD | PLANNED_PERIOD | AMBIGUOUS | NONE | MANUALLY_ASSIGNED
  rentalMatchDayOnly        Boolean   @default(false) // Zuordnung nur tagesgenau (Tatzeit unbekannt)
  assignmentStatus          String    @default("UNASSIGNED") // UNASSIGNED | VEHICLE_ONLY | ASSIGNED | NO_MATCH
  driverDeterminationStatus String    @default("UNDETERMINED") // UNDETERMINED | CONTRACT_DRIVER_SELECTED | OTHER_DRIVER_ENTERED | NOT_IDENTIFIABLE | NO_DRIVER_INFORMATION
  driverContractDriverId    String?
  driverCustomerId          String? // nur wenn die bewusst bestimmte Person ein Kunde ist (Kundenakte)
  driverSnapshot            Json? // bewusst bestimmte Person: firstName, lastName, birthDate?, street?, zip?, city?, country?, source
  driverNote                String?
  responseDeadline          DateTime? // aus dem Schreiben übernommen oder manuell; nie automatisch berechnet
  noticeAmountCents         Int? // nur Information
  notes                     String?
  internalNote              String?
  closedAt                  DateTime?
  closedById                String?
  closedByName              String?
  closeReason               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  createdById               String?
  createdByName             String?

  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  booking   Booking?                     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  contract  RentalContract?              @relation(fields: [contractId], references: [id], onDelete: SetNull)
  documents AuthorityCaseDocument[]
  responses AuthorityResponse[]
  receipts  AuthoritySubmissionReceipt[]
  events    AuthorityCaseEvent[]
  uploads   AuthorityUpload[]
  invoices  Invoice[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, bookingId])
  @@index([tenantId, responseDeadline])
  @@index([tenantId, licensePlateNormalized])
  @@index([tenantId, driverCustomerId])
}

// Originalschreiben, Nachweise, erzeugte Antwort-PDFs: privat gespeichert, nur anfügen; Korrektur = Archivierung mit Grund.
// Behörden-Adressbuch: lernt Name, Anschrift, E-Mail und Portal aus erfassten Vorgängen, damit das nächste Schreiben
// derselben Behörde vorbelegt ist. Nur Behördendaten, keine Personendaten, keine Zugangsdaten.
model AuthorityContact {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  nameKey    String // Vergleichsschlüssel (klein, ohne Satzzeichen/Mehrfachleerzeichen)
  department String?
  address    String?
  email      String?
  portalUrl  String?
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nameKey])
}

// Hochgeladenes Behördenschreiben vor der Anlage eines Vorgangs: Datei liegt privat im Speicher, der erkannte Vorschlag
// wird nur angezeigt. Beim Anlegen wird die Datei als „Behördenschreiben“ an den Vorgang gehängt (caseId, usedAt).
model AuthorityUpload {
  id            String    @id @default(cuid())
  tenantId      String
  fileName      String
  storageKey    String    @unique
  contentType   String
  sizeBytes     Int
  checksum      String
  textLength    Int       @default(0) // Länge der gelesenen Textebene; 0 = Scan/Foto ohne Text
  suggestion    Json? // erkannte Vorschläge (ExtractionSuggestion), nie verbindlich
  caseId        String?
  usedAt        DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   AuthorityCase? @relation(fields: [caseId], references: [id])

  @@index([tenantId, createdAt])
}

model AuthorityCaseDocument {
  id             String    @id @default(cuid())
  tenantId       String
  caseId         String
  responseId     String?
  type           String // INCOMING_NOTICE | EVIDENCE | RESPONSE_DRAFT | RESPONSE_PDF | SUBMISSION_RECEIPT | CORRESPONDENCE | OTHER
  fileName       String
  storageKey     String    @unique
  contentType    String
  sizeBytes      Int
  checksum       String
  note           String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?
  archivedByName String?
  archiveReason  String?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     AuthorityCase      @relation(fields: [caseId], references: [id])
  response AuthorityResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)

  @@index([tenantId, caseId])
}

// Antwortfassung: Snapshot aller übermittelten Angaben. DRAFT ist bearbeitbar; ab APPROVED unveränderlich.
// Korrekturen erzeugen eine neue Fassung (höhere version); ältere Fassungen bleiben erhalten.
model AuthorityResponse {
  id                  String    @id @default(cuid())
  tenantId            String
  caseId              String
  version             Int
  status              String    @default("DRAFT") // DRAFT | APPROVED | SUBMITTED | FAILED | SUPERSEDED
  responseType        String // DRIVER_IDENTIFIED | MULTIPLE_POSSIBLE_DRIVERS | DRIVER_NOT_IDENTIFIABLE | NO_MATCHING_RENTAL | VEHICLE_NOT_IN_FLEET | CUSTOM_RESPONSE
  submissionMethod    String // MANUAL_PORTAL | POST | EMAIL | VERIFIED_API | OTHER
  recipientSnapshot   Json // Behörde, Abteilung, Anschrift, E-Mail/Portal wie zum Zeitpunkt der Antwort
  authorityReference  String
  senderSnapshot      Json // Vermieterdaten (Name, Anschrift, Kontakt)
  vehicleSnapshot     Json // Kennzeichen laut Schreiben, ggf. Fahrzeug
  offenseSnapshot     Json // Art, Tatzeit (mit/ohne Uhrzeit), Tatort
  rentalSnapshot      Json? // Buchung/Vertrag/Mietzeitraum, falls übermittelt
  personSnapshot      Json? // ausschließlich die bewusst ausgewählten Personendaten
  freeText            String?
  contentHash         String?
  createdById         String?
  createdByName       String?
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?
  approvedById        String?
  approvedByName      String?
  submittedAt         DateTime?
  submittedById       String?
  submittedByName     String?
  submissionReference String?
  emailLogId          String?
  pdfDocumentId       String?
  failureReason       String?

  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case      AuthorityCase                @relation(fields: [caseId], references: [id])
  documents AuthorityCaseDocument[]
  receipts  AuthoritySubmissionReceipt[]

  @@unique([caseId, version])
  @@index([tenantId, caseId])
}

// Übermittlungsnachweis: nur anfügen.
model AuthoritySubmissionReceipt {
  id            String   @id @default(cuid())
  tenantId      String
  caseId        String
  responseId    String
  method        String
  submittedAt   DateTime
  reference     String?
  note          String?
  documentId    String? // Nachweisdokument (AuthorityCaseDocument SUBMISSION_RECEIPT)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     AuthorityCase     @relation(fields: [caseId], references: [id])
  response AuthorityResponse @relation(fields: [responseId], references: [id])

  @@index([tenantId, caseId])
}

// Historie des Vorgangs, nur anfügen; keine Personendaten außer Namen der bewusst bestimmten Person.
model AuthorityCaseEvent {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  type      String
  fromValue String?
  toValue   String?
  note      String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   AuthorityCase @relation(fields: [caseId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 15: Mietbedingungen als versionierter Text. Nur Entwürfe sind änderbar; veröffentlichte und archivierte
// Fassungen sind unveränderlich (DB-Trigger). Verträge frieren die verwendete Fassung ein (RentalContract.termsText/Hash).
// ---------------------------------------------------------------------------

model RentalTermsVersion {
  id              String    @id @default(cuid())
  tenantId        String
  versionNumber   Int // fortlaufend je Mandant, wird nie wiederverwendet
  label           String // Anzeige, z. B. 1.0, 1.1, 2.0 – je Mandant eindeutig
  title           String
  status          String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  effectiveFrom   DateTime? // optional: ab wann die Fassung für neue Verträge gilt
  content         String // Markdown-Teilmenge (Überschriften, Absätze, Listen, fett), siehe src/lib/terms-markdown.ts
  contentFormat   String    @default("MARKDOWN")
  changeNote      String?
  checksum        String? // sha256 des Inhalts, bei Veröffentlichung gesetzt, danach fest
  sourceVersionId String? // Fassung, aus der dieser Entwurf kopiert wurde
  createdAt       DateTime  @default(now())
  createdById     String?
  createdByName   String?
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?
  publishedById   String?
  publishedByName String?
  archivedAt      DateTime?
  archivedById    String?
  archivedByName  String?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts RentalContract[]

  @@unique([tenantId, versionNumber])
  @@unique([tenantId, label])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Phase 19.5: Fahreridentifikation und Führerscheinprüfung bei der Übergabe.
// DriverVerification = unveränderlicher Prüfvermerk je Fahrer und Übergabe (Original vorgelegt, Daten geprüft, wer, wann).
// DriverDocumentCopy = optionale, getrennt gespeicherte Dokumentkopie mit Zustimmung, Zweck und Aufbewahrung.
// Die Kopie ersetzt nie die Prüfung; das Löschen einer Kopie lässt den Prüfvermerk unberührt.
// ---------------------------------------------------------------------------

model DriverVerification {
  id               String  @id @default(cuid())
  tenantId         String
  bookingId        String
  contractId       String
  handoverId       String
  contractDriverId String
  customerId       String? // nur Referenz (Kundenakte); maßgeblich sind die Snapshots
  version          Int     @default(1) // Korrektur = neue Fassung, die alte bleibt (supersededById)
  supersededById   String?

  driverRole              String // PRIMARY_DRIVER | ADDITIONAL_DRIVER (aus dem Vertrag)
  driverFirstNameSnapshot String
  driverLastNameSnapshot  String
  driverBirthDateSnapshot DateTime

  status String @default("IN_PROGRESS") // IN_PROGRESS | CONFIRMED | BLOCKED

  // Identität (Originaldokument vorgelegt, Abgleich – keine Kopie, keine Seriennummer)
  identityDocumentType     String? // PERSONALAUSWEIS | REISEPASS | SONSTIGER_AMTLICHER_LICHTBILDAUSWEIS
  identityOriginalSeen     Boolean   @default(false)
  identityNameMatched      Boolean?
  identityBirthDateMatched Boolean?
  identityCheckedAt        DateTime?
  identityCheckedById      String?
  identityCheckedByName    String?

  // Führerschein (Originaldokument vorgelegt, Daten wie auf dem Dokument – Snapshot dieser Übergabe)
  licenseOriginalSeen          Boolean   @default(false)
  licenseDocumentValid         Boolean?
  licenseNameMatched           Boolean?
  licenseNumberSnapshot        String?
  licenseCountrySnapshot       String?
  licenseIssuedAtSnapshot      DateTime?
  licenseValidUntilSnapshot    DateTime?
  licenseClassesSnapshot       String[]  @default([])
  requiredLicenseClassSnapshot String?
  licenseClassSatisfied        Boolean?
  internationalPermitPresented Boolean   @default(false)
  translationPresented         Boolean   @default(false)
  manualReviewRequired         Boolean   @default(false)
  manualReviewConfirmed        Boolean?
  deviatesFromCustomer         Boolean   @default(false)
  deviationConfirmed           Boolean?
  licenseCheckedAt             DateTime?
  licenseCheckedById           String?
  licenseCheckedByName         String?

  verifiedAt     DateTime?
  verifiedById   String?
  verifiedByName String?
  blockedReasons String[]  @default([])
  notes          String?
  contentHash    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking              @relation(fields: [bookingId], references: [id])
  contract       RentalContract       @relation(fields: [contractId], references: [id])
  handover       Handover             @relation(fields: [handoverId], references: [id])
  contractDriver ContractDriver       @relation(fields: [contractDriverId], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  documentCopies DriverDocumentCopy[]

  @@unique([tenantId, handoverId, contractDriverId, version])
  @@index([tenantId, handoverId])
  @@index([tenantId, customerId, verifiedAt])
  @@index([tenantId, bookingId])
}

model DriverDocumentCopy {
  id                    String    @id @default(cuid())
  tenantId              String
  bookingId             String
  handoverId            String
  verificationId        String
  contractDriverId      String
  documentKind          String // IDENTITY | LICENSE
  side                  String    @default("FRONT") // FRONT | BACK
  storageKey            String    @unique
  contentType           String
  sizeBytes             Int
  checksum              String
  width                 Int?
  height                Int?
  markedAsCopy          Boolean   @default(true) // serverseitig als Kopie gekennzeichnet (Overlay), Original nicht aufbewahrt
  purposeSnapshot       String
  consentRequired       Boolean   @default(false)
  consentGiven          Boolean   @default(false)
  consentAt             DateTime?
  consentRecordedById   String?
  consentRecordedByName String?
  retentionUntil        DateTime?
  deletionStatus        String    @default("ACTIVE") // ACTIVE | DELETED
  deletedAt             DateTime?
  deletedById           String?
  deletedByName         String?
  deletionReason        String?
  createdById           String?
  createdByName         String?
  createdAt             DateTime  @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking            @relation(fields: [bookingId], references: [id])
  handover       Handover           @relation(fields: [handoverId], references: [id])
  verification   DriverVerification @relation(fields: [verificationId], references: [id])
  contractDriver ContractDriver     @relation(fields: [contractDriverId], references: [id])

  @@index([tenantId, handoverId])
  @@index([tenantId, verificationId])
  @@index([tenantId, deletionStatus, retentionUntil])
}
