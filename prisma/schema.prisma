// Rent-Base Datenmodell, Etappe 1
// Jede fachliche Tabelle trägt tenantId (Mandant). PostgreSQL lokal (prisma dev) und auf dem Server.
// Enums sind bewusst als String abgelegt; gültige Werte stehen in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  street    String?
  zip       String?
  city      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  groups    VehicleGroup[]
  vehicles  Vehicle[]
  customers Customer[]
  bookings  Booking[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("OWNER") // OWNER | DISPO | YARD
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([tenantId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fahrzeuggruppe: z. B. Transporter 3,5 t, Kompaktklasse. Preise dienen als Vorgabe beim Anlegen eines Fahrzeugs.
model VehicleGroup {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  sortOrder        Int      @default(0)
  dailyRate        Decimal  @default(0)
  weeklyRate       Decimal?
  monthlyRate      Decimal?
  kmIncludedPerDay Int      @default(200)
  extraKmRate      Decimal  @default(0.25)
  deposit          Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

model Vehicle {
  id               String    @id @default(cuid())
  tenantId         String
  plate            String
  make             String
  model            String
  groupId          String?
  fuel             String    @default("DIESEL") // DIESEL | BENZIN | ELEKTRO | HYBRID
  year             Int?
  vin              String?
  color            String?
  mileage          Int       @default(0)
  huDate           DateTime?
  status           String    @default("AVAILABLE") // AVAILABLE | WORKSHOP | BLOCKED | INACTIVE
  dailyRate        Decimal   @default(0)
  weeklyRate       Decimal?
  monthlyRate      Decimal?
  kmIncludedPerDay Int       @default(200)
  extraKmRate      Decimal   @default(0.25)
  deposit          Decimal   @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    VehicleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@unique([tenantId, plate])
  @@index([tenantId, groupId])
  @@index([tenantId, status])
}

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  type              String    @default("PRIVATE") // PRIVATE | COMPANY
  companyName       String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  street            String?
  zip               String?
  city              String?
  birthDate         DateTime?
  licenseNumber     String?
  licenseClass      String?
  licenseIssuedAt   DateTime?
  licenseValidUntil DateTime?
  blocked           Boolean   @default(false)
  blockReason       String?
  discountPercent   Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId, lastName])
}

model Booking {
  id         String   @id @default(cuid())
  tenantId   String
  number     String // z. B. 2026-0001, fortlaufend pro Mandant
  vehicleId  String
  customerId String
  startAt    DateTime
  endAt      DateTime
  status     String   @default("RESERVED") // RESERVED | ACTIVE | RETURNED | CANCELLED
  dailyRate  Decimal  @default(0) // Preis-Snapshot bei Buchung
  deposit    Decimal  @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, vehicleId, startAt, endAt])
  @@index([tenantId, status])
}
