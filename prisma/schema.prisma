// Rent-Base Datenmodell, Etappe 1
// Jede fachliche Tabelle trägt tenantId (Mandant). PostgreSQL lokal (prisma dev) und auf dem Server.
// Enums sind bewusst als String abgelegt; gültige Werte stehen in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  street             String?
  zip                String?
  city               String?
  phone              String?
  email              String?
  rentalTermsVersion String? // z. B. "2026-09"
  rentalTermsText    String? // Mietbedingungen, werden beim Vertrag kopiert

  // Rechnungsdaten (Phase 8). "street" enthält Straße und Hausnummer, keine doppelte Speicherung.
  legalForm        String? // z. B. GmbH, e. K., Einzelunternehmen; Teil des vollständigen Unternehmensnamens
  country          String   @default("DE")
  vatId            String? // Umsatzsteuer-Identifikationsnummer
  taxNumber        String? // Steuernummer
  bankName         String?
  iban             String?
  bic              String?
  invoiceFooter    String? // Fußtext auf Rechnungen
  paymentTermDays  Int? // Zahlungsziel in Tagen ab Rechnungsdatum
  defaultTaxRate   Decimal? // Steuersatz in Prozent für Rechnungspositionen; null = noch nicht konfiguriert
  pricesIncludeTax Boolean? // true: Vertrags- und Zusatzkostenbeträge sind Bruttobeträge; null = noch nicht entschieden
  taxNote          String? // Hinweistext, der bei Positionen mit 0 % auf der Rechnung erscheint (Inhalt entscheidet der Inhaber)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users     User[]
  groups    VehicleGroup[]
  vehicles  Vehicle[]
  customers Customer[]
  bookings  Booking[]

  sketches            VehicleSketch[]
  contracts           RentalContract[]
  contractDrivers     ContractDriver[]
  handovers           Handover[]
  damages             Damage[]
  handoverDamages     HandoverDamage[]
  checklistTemplates  ChecklistTemplate[]
  checklistItems      HandoverChecklistItem[]
  photos              Photo[]
  signatures          Signature[]
  documents           Document[]
  extraCharges        ExtraCharge[]
  emailLogs           EmailLog[]
  vehicleEvents       VehicleEvent[]
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  payments            Payment[]
  deposits            SecurityDeposit[]
  depositEvents       SecurityDepositEvent[]
  auditLogs           AuditLog[]
  invoiceVersions     InvoiceVersion[]
  invoiceVersionItems InvoiceVersionItem[]
  damageCases         DamageCase[]
  damageCaseEvents    DamageCaseEvent[]
  damageCaseDocuments DamageCaseDocument[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("OWNER") // OWNER | DISPO | YARD
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  Session[]
  handovers Handover[]

  @@index([tenantId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fahrzeuggruppe: z. B. Transporter 3,5 t, Kompaktklasse. Preise dienen als Vorgabe beim Anlegen eines Fahrzeugs.
model VehicleGroup {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  sortOrder        Int      @default(0)
  dailyRate        Decimal  @default(0) // Tagespreis
  workWeekRate     Decimal? // Woche, 5 Tage (Mo bis Fr)
  weeklyRate       Decimal? // Kalenderwoche, 7 Tage
  monthlyRate      Decimal? // Monat, 30 Tage
  kmIncludedPerDay Int      @default(200)
  extraKmRate      Decimal  @default(0.25)
  deposit          Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bodyType String  @default("PKW") // PKW | TRANSPORTER, bestimmt die Fallback-Skizze
  sketchId String? // eigene Skizze der Gruppe, sonst Fallback nach bodyType

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sketch             VehicleSketch?      @relation(fields: [sketchId], references: [id], onDelete: SetNull)
  vehicles           Vehicle[]
  checklistTemplates ChecklistTemplate[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

model Vehicle {
  id                 String    @id @default(cuid())
  tenantId           String
  plate              String
  make               String
  model              String
  groupId            String?
  fuel               String    @default("DIESEL") // DIESEL | BENZIN | ELEKTRO | HYBRID
  year               Int?
  vin                String?
  color              String?
  mileage            Int       @default(0)
  huDate             DateTime?
  status             String    @default("AVAILABLE") // AVAILABLE | WORKSHOP | BLOCKED | INACTIVE
  dailyRate          Decimal   @default(0) // Tagespreis
  workWeekRate       Decimal? // Woche, 5 Tage (Mo bis Fr)
  weeklyRate         Decimal? // Kalenderwoche, 7 Tage
  monthlyRate        Decimal? // Monat, 30 Tage
  kmIncludedPerDay   Int       @default(200)
  extraKmRate        Decimal   @default(0.25)
  deposit            Decimal   @default(0)
  tankCapacityLiters Int? // für die Berechnung von Tankfehlbeträgen
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       VehicleGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  bookings    Booking[]
  contracts   RentalContract[]
  handovers   Handover[]
  damages     Damage[]
  damageCases DamageCase[]
  events      VehicleEvent[]

  @@unique([tenantId, plate])
  @@index([tenantId, groupId])
  @@index([tenantId, status])
}

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  number            String? // Kundennummer, z. B. K-00001, fortlaufend je Mandant
  type              String    @default("PRIVATE") // PRIVATE | COMPANY
  companyName       String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  street            String?
  zip               String?
  city              String?
  country           String    @default("DE")
  birthDate         DateTime?
  birthPlace        String?
  nationality       String?
  idType            String? // PERSONALAUSWEIS | REISEPASS | AUFENTHALTSTITEL | SONSTIGES
  idNumber          String?
  idIssuedBy        String? // ausstellende Behörde
  idIssuedAt        DateTime?
  idValidUntil      DateTime?
  licenseNumber     String?
  licenseClass      String?
  licenseIssuedBy   String? // ausstellende Behörde
  licenseIssuedAt   DateTime?
  licenseValidUntil DateTime?
  blocked           Boolean   @default(false)
  blockReason       String?
  discountPercent   Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  contracts       RentalContract[]
  contractDrivers ContractDriver[]
  invoices        Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, lastName])
}

model Booking {
  id             String    @id @default(cuid())
  tenantId       String
  number         String // z. B. 2026-0001, fortlaufend pro Mandant
  vehicleId      String
  customerId     String
  startAt        DateTime
  endAt          DateTime
  status         String    @default("RESERVED") // RESERVED | ACTIVE | RETURNED | CANCELLED
  dailyRate      Decimal   @default(0) // Preis-Snapshot bei Buchung
  workWeekRate   Decimal? // Snapshot Woche (5 Tage)
  weeklyRate     Decimal? // Snapshot Kalenderwoche (7 Tage)
  monthlyRate    Decimal? // Snapshot Monat (30 Tage)
  deposit        Decimal   @default(0)
  actualPickupAt DateTime? // gesetzt beim Finalisieren der Übergabe
  actualReturnAt DateTime? // gesetzt beim Finalisieren der Rückgabe
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  contract        RentalContract?
  handovers       Handover[]
  damages         Damage[]
  documents       Document[]
  invoices        Invoice[]
  extraCharges    ExtraCharge[]
  emailLogs       EmailLog[]
  vehicleEvents   VehicleEvent[]
  payments        Payment[]
  securityDeposit SecurityDeposit?
  damageCases     DamageCase[]

  @@unique([tenantId, number])
  @@index([tenantId, vehicleId, startAt, endAt])
  @@index([tenantId, status])
}

// ============================================================================
// Etappe 2: Mietvertrag, Übergabe, Rückgabe, Schäden, Dokumente
// Grundsatz: Booking bleibt der Anker. Verträge und Protokolle sind versiegelte Kopien (Snapshots),
// keine Sicht auf Live-Daten. Zusätzlich schützen Datenbank-Trigger finalisierte Datensätze.
// ============================================================================

// Fahrzeugskizze für die Schadenkarte. Jede Version ist eine eigene, unveränderliche Zeile.
// tenantId = null: Systemskizze (Fallback "allgemeiner PKW" / "allgemeiner Transporter").
model VehicleSketch {
  id        String   @id @default(cuid())
  tenantId  String?
  code      String // GENERIC_PKW | GENERIC_TRANSPORTER | frei wählbar je Mandant
  name      String
  bodyType  String // PKW | TRANSPORTER
  version   Int      @default(1)
  assetPath String // Pfad unter /public oder Storage Key der SVG-Datei
  assetHash String // sha256 der Datei, damit die verwendete Fassung nachweisbar ist
  views     Json // [{ key, label, box }] Reihenfolge der Ansichten, box = Rahmen im Zeichenfeld
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups    VehicleGroup[]
  handovers Handover[]

  @@unique([tenantId, code, version])
  @@index([tenantId, bodyType, active])
}

// Mietvertrag, 1:1 zur Buchung. Alle Konditionen sind beim Anlegen kopiert und ab Unterschrift eingefroren.
model RentalContract {
  id         String @id @default(cuid())
  tenantId   String
  bookingId  String @unique
  number     String // z. B. MV-2026-0001
  status     String @default("DRAFT") // DRAFT | SIGNED | CANCELLED
  customerId String // Referenz, maßgeblich ist customerSnapshot
  vehicleId  String // Referenz, maßgeblich ist vehicleSnapshot

  customerSnapshot Json // Name, Adresse, Ausweis, Führerschein zum Vertragszeitpunkt
  vehicleSnapshot  Json // Kennzeichen, Marke, Modell, Gruppe, FIN, Antrieb zum Vertragszeitpunkt
  priceSnapshot    Json // verwendete Preisstufen, Berechnungsstrategie und Aufschlüsselung

  startAt           DateTime
  endAt             DateTime
  totalAmount       Decimal  @default(0)
  discountPercent   Int      @default(0)
  deposit           Decimal  @default(0)
  kmIncludedPerDay  Int      @default(0)
  extraKmRate       Decimal  @default(0)
  deductible        Decimal  @default(0) // Selbstbeteiligung
  fuelPolicy        String   @default("FULL_TO_FULL") // FULL_TO_FULL | SAME_LEVEL | INCLUDED | OTHER
  fuelPolicyNote    String? // Beschreibung bei OTHER
  fuelPricePerLiter Decimal? // Preis je fehlendem Liter inkl. Service
  agreedTotal       Decimal? // abweichend vereinbarter Gesamtmietpreis, sonst gilt die Berechnung
  agreedTotalNote   String?
  pickupLocation    String?
  returnLocation    String?
  internalNote      String? // nur intern, nicht Teil des unterschriebenen Inhalts
  driverMode        String   @default("RENTER") // RENTER = Mieter fährt selbst | OTHER = abweichender Fahrer
  wizardStep        Int      @default(1) // zuletzt erreichter Schritt im Assistenten
  conditions        Json? // weitere Konditionen, erweiterbar ohne Migration
  landlordSnapshot  Json? // Vermieterdaten (Name, Anschrift, Kontakt) zum Zeitpunkt des Abschlusses, für Dokumente

  termsVersion String? // AGB-Version
  termsHash    String? // sha256 des AGB-Textes
  termsText    String? // Kopie der Mietbedingungen zum Vertragszeitpunkt
  contentHash  String? // sha256 über den unterschriebenen Vertragsinhalt

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  signedAt    DateTime?
  cancelledAt DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking    Booking           @relation(fields: [bookingId], references: [id])
  customer   Customer          @relation(fields: [customerId], references: [id])
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])
  drivers    ContractDriver[]
  handovers  Handover[]
  signatures Signature[]
  documents  Document[]
  invoices   Invoice[]
  deposits   SecurityDeposit[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

// Fahrer und Zusatzfahrer am Vertrag. Eigene Kopie der Daten, optionale Verbindung zu einem Kunden.
model ContractDriver {
  id         String  @id @default(cuid())
  tenantId   String
  contractId String
  customerId String? // nur Referenz; spätere Änderungen am Kunden wirken hier nicht
  role       String  @default("ADDITIONAL_DRIVER") // PRIMARY_DRIVER | ADDITIONAL_DRIVER

  firstName String
  lastName  String
  birthDate DateTime
  street    String
  zip       String
  city      String
  country   String   @default("DE")

  licenseNumber     String
  licenseClass      String
  licenseIssuedAt   DateTime
  licenseValidUntil DateTime?
  licenseCountry    String    @default("DE")
  licenseIssuedBy   String?

  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, contractId])
}

// Übergabe (PICKUP) und Rückgabe (RETURN) in einem Modell.
model Handover {
  id         String  @id @default(cuid())
  tenantId   String
  bookingId  String
  vehicleId  String
  contractId String?
  type       String // PICKUP | RETURN
  status     String  @default("DRAFT") // DRAFT | FINALIZED
  number     String // z. B. UP-2026-0001 (Übergabe), RP-2026-0001 (Rückgabe)

  employeeId   String?
  employeeName String // Kopie, falls der Benutzer später umbenannt oder entfernt wird

  mileage          Int?
  fuelLevelEighths Int? // 0 bis 8
  batteryPercent   Int? // 0 bis 100
  driveType        String // Kopie von Vehicle.fuel beim Start
  accessories      Json? // mitgegebenes oder zurückgegebenes Zubehör
  notes            String?

  sketchId        String?
  sketchVersion   Int?
  sketchAssetHash String? // genau diese Skizzenfassung wurde verwendet

  correctsId        String? // Nachtrag: verweist auf das ursprüngliche Protokoll
  wizardStep        Int      @default(1) // zuletzt erreichter Schritt im Assistenten
  fuelPricePerLiter Decimal? // nur Rückgabe: bei der Rückgabe ausdrücklich angegebener Literpreis, falls der Vertrag keinen nennt

  startedAt   DateTime  @default(now())
  finalizedAt DateTime?
  contentHash String? // sha256 über den versiegelten Inhalt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking     Booking         @relation(fields: [bookingId], references: [id])
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
  contract    RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  employee    User?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sketch      VehicleSketch?  @relation(fields: [sketchId], references: [id], onDelete: SetNull)
  corrects    Handover?       @relation("HandoverCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections Handover[]      @relation("HandoverCorrection")

  damages        HandoverDamage[]
  checklistItems HandoverChecklistItem[]
  photos         Photo[]
  signatures     Signature[]
  documents      Document[]
  extraCharges   ExtraCharge[]
  discovered     Damage[]
  vehicleEvents  VehicleEvent[]
  invoices       Invoice[]
  damageCases    DamageCase[]

  @@unique([tenantId, number])
  @@index([tenantId, bookingId, type])
  @@index([tenantId, vehicleId, finalizedAt])
}

// Schadenakte des Fahrzeugs. Lebt weiter, wird nie gelöscht. Positionen normalisiert 0..1.
model Damage {
  id          String  @id @default(cuid())
  tenantId    String
  vehicleId   String
  view        String // LEFT | RIGHT | FRONT | REAR | TOP | INTERIOR
  posX        Float // 0..1, relativ zur Ansicht
  posY        Float // 0..1
  kind        String // SCRATCH | DENT | CRACK | CHIP | BROKEN | MISSING_PART | STAIN | OTHER
  description String
  size        String? // z. B. "ca. 12 cm"
  severity    String  @default("MINOR") // MINOR | MODERATE | SEVERE
  status      String  @default("OPEN") // OPEN | DOCUMENTED | REPAIR_PLANNED | IN_REPAIR | REPAIRED

  discoveredAt           DateTime  @default(now())
  discoveredInHandoverId String?
  bookingId              String? // Miete, in der der Schaden entstanden ist
  reportedById           String?
  repairedAt             DateTime?
  repairNote             String?
  settlementReview       Boolean   @default(false) // bei Rückgabe festgestellt: Schadenabrechnung ist intern zu prüfen (keine Haftungsfeststellung)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id])
  discoveredIn Handover?        @relation(fields: [discoveredInHandoverId], references: [id], onDelete: SetNull)
  booking      Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  snapshots    HandoverDamage[]
  photos       Photo[]
  extraCharges ExtraCharge[]
  events       VehicleEvent[]
  damageCase   DamageCase? // operative Schadenakte (Phase 12), genau eine je Schaden

  @@index([tenantId, vehicleId, status])
}

// Schaden im Protokoll: echte Kopie des damaligen Zustands, keine Sicht auf Damage.
model HandoverDamage {
  id         String  @id @default(cuid())
  tenantId   String
  handoverId String
  damageId   String? // nur Referenz zur Schadenakte
  marker     String // EXISTING | NEW

  view        String
  posX        Float
  posY        Float
  kind        String
  description String
  size        String?
  severity    String
  photoRefs   Json     @default("[]") // [{ photoId, storageKey, checksum }] zum Zeitpunkt des Protokolls
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  damage   Damage?  @relation(fields: [damageId], references: [id], onDelete: SetNull)
  photos   Photo[]

  @@index([tenantId, handoverId])
}

// Checklisten-Vorlage je Mandant, optional je Fahrzeuggruppe. Jede Version ist eine eigene Zeile.
model ChecklistTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String?
  handoverType String   @default("BOTH") // PICKUP | RETURN | BOTH
  name         String
  version      Int      @default(1)
  active       Boolean  @default(true)
  items        Json // [{ key, label, answerType, required }]
  createdAt    DateTime @default(now())

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  VehicleGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  used   HandoverChecklistItem[]

  @@unique([tenantId, name, version])
  @@index([tenantId, active])
}

// Tatsächlich verwendete Frage samt Antwort, als Kopie im Protokoll.
model HandoverChecklistItem {
  id              String  @id @default(cuid())
  tenantId        String
  handoverId      String
  templateId      String?
  templateVersion Int?
  itemKey         String
  label           String
  answerType      String  @default("OK_NOT_OK") // OK_NOT_OK | YES_NO | TEXT
  required        Boolean @default(true)
  result          String? // OK | NOT_OK | YES | NO | Freitext
  note            String?
  sortOrder       Int     @default(0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover           @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
}

// Foto im privaten Object Storage. Es wird nur der Storage Key gespeichert, nie eine öffentliche URL.
model Photo {
  id               String    @id @default(cuid())
  tenantId         String
  handoverId       String?
  damageId         String?
  handoverDamageId String?
  damageCaseId     String? // zusätzliche Fotos zur Schadenakte (Detail, Werkstatt, nach Reparatur)
  caption          String? // kurze Beschreibung, z. B. "Werkstattaufnahme"
  storageKey       String    @unique
  category         String // FRONT | REAR | LEFT | RIGHT | INTERIOR | ODOMETER | FUEL | DAMAGE | DOCUMENT | OTHER
  contentType      String
  sizeBytes        Int
  checksum         String // sha256
  width            Int?
  height           Int?
  takenAt          DateTime?
  uploadedAt       DateTime  @default(now())
  createdById      String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover       Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  damage         Damage?         @relation(fields: [damageId], references: [id], onDelete: SetNull)
  handoverDamage HandoverDamage? @relation(fields: [handoverDamageId], references: [id], onDelete: SetNull)
  damageCase     DamageCase?     @relation(fields: [damageCaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
  @@index([tenantId, damageId])
  @@index([tenantId, damageCaseId])
}

// Unterschrift, gebunden an genau den Inhalt (contentHash), der unterschrieben wurde.
model Signature {
  id            String   @id @default(cuid())
  tenantId      String
  handoverId    String?
  contractId    String?
  role          String // RENTER | EMPLOYEE
  signerName    String
  storageKey    String   @unique // vorgesehener Ort im Object Storage
  imageData     Bytes? // PNG der Unterschrift; liegt in der Datenbank, bis der Object Storage angebunden ist
  imageChecksum String? // sha256 des Bildes
  contentHash   String // Hash des unterschriebenen Inhalts
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  createdById   String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  handover Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  contract RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId, handoverId])
  @@index([tenantId, contractId])
}

// Erzeugtes Dokument (PDF). Unveränderlich archiviert: einmal erzeugt, nie überschrieben.
model Document {
  id               String   @id @default(cuid())
  tenantId         String
  bookingId        String
  contractId       String?
  handoverId       String?
  invoiceId        String?
  invoiceVersionId String? // Rechnungsfassung, aus der das PDF entstand
  type             String // RENTAL_CONTRACT | PICKUP_PROTOCOL | RETURN_PROTOCOL | INVOICE
  storageKey       String   @unique
  fileName         String
  contentType      String   @default("application/pdf")
  sizeBytes        Int
  checksum         String // sha256 der gespeicherten Datei
  sourceHash       String? // Prüfsumme (contentHash) des versiegelten Vertrags oder Protokolls, aus dem das PDF entstand
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  createdById      String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking         @relation(fields: [bookingId], references: [id])
  contract       RentalContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  handover       Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceVersion InvoiceVersion? @relation(fields: [invoiceVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookingId, type])
}

// Zusatzkosten mit vollständiger Rechengrundlage, z. B. 342 km × 0,25 € = 85,50 €.
model ExtraCharge {
  id               String   @id @default(cuid())
  tenantId         String
  bookingId        String
  handoverId       String?
  damageId         String?
  type             String // EXTRA_MILEAGE | FUEL | CHARGING | CLEANING | LATE_RETURN | MISSING_ACCESSORY | DAMAGE | OTHER
  description      String
  quantity         Decimal
  unit             String // km, l, kWh, h, Stk, pauschal
  unitPrice        Decimal
  amount           Decimal
  formula          String // lesbare Rechnung
  calculation      Json // Eingangswerte der Rechnung
  source           String   @default("MANUAL") // PROPOSAL = vom System vorgeschlagen und vom Mitarbeiter bestätigt | MANUAL = frei erfasst
  internalNote     String? // nur intern, nicht auf Dokumenten
  handoverDamageId String? // Bezug zum im Protokoll erfassten Schaden (bis zum Abschluss gibt es noch keine Schadenakte)
  createdAt        DateTime @default(now())
  createdById      String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id])
  handover     Handover?     @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  damage       Damage?       @relation(fields: [damageId], references: [id], onDelete: SetNull)
  invoiceItems InvoiceItem[]

  @@index([tenantId, bookingId])
}

// Protokoll jedes Mailversuchs. Ein Fehler hier macht nie eine Übergabe oder Rückgabe rückgängig.
model EmailLog {
  id                String    @id @default(cuid())
  tenantId          String
  bookingId         String?
  recipient         String
  subject           String
  template          String // z. B. PICKUP_PROTOCOL
  attachments       Json      @default("[]") // [{ documentId, fileName, checksum }]
  status            String    @default("PENDING") // PENDING | SENT | FAILED
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  idempotencyKey    String
  handoverId        String? // Bezug zum Protokoll, nur Referenz
  invoiceId         String? // Bezug zur Rechnung, nur Referenz
  invoiceVersionId  String? // welche Rechnungsfassung versendet wurde (Anhang = deren PDF)
  trigger           String    @default("AUTO") // AUTO = nach Abschluss | MANUAL = "erneut senden"
  attemptNo         Int       @default(1) // fortlaufender Versuch je Buchung und Vorlage
  createdById       String?
  createdAt         DateTime  @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceVersion InvoiceVersion? @relation(fields: [invoiceVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, bookingId, createdAt])
  @@index([tenantId, invoiceVersionId])
}

// Fahrzeughistorie, nur anfügen.
model VehicleEvent {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  type        String // PICKUP | RETURN | MILEAGE | DAMAGE_DISCOVERED | DAMAGE_REPAIRED
  occurredAt  DateTime @default(now())
  mileage     Int?
  bookingId   String?
  damageId    String?
  handoverId  String?
  userId      String?
  userName    String?
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  damage   Damage?   @relation(fields: [damageId], references: [id], onDelete: SetNull)
  handover Handover? @relation(fields: [handoverId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId, occurredAt])
}

// Rechnung. Beträge, Empfänger und Firmendaten sind ab dem Abschluss versiegelte Kopien; nichts wird beim
// Anzeigen aus Buchung, Vertrag oder Zusatzkosten neu berechnet. Die Nummer wird erst beim Abschluss vergeben.
model Invoice {
  id               String  @id @default(cuid())
  tenantId         String
  bookingId        String
  customerId       String? // nur Referenz, maßgeblich ist customerSnapshot
  contractId       String? // Vertrag, aus dem der Mietpreis stammt
  returnHandoverId String? // Rückgabe, aus der die bestätigten Zusatzkosten stammen
  number           String? // z. B. RE-2026-000001, erst beim Abschluss vergeben
  status           String  @default("DRAFT") // DRAFT | FINALIZED | (vorbereitet: CANCELLED, CREDITED)
  // Phase 12: Rechnungsart. RENTAL = Mietrechnung (höchstens eine abgeschlossene je Buchung), DAMAGE = Schadenabrechnung zu einer Schadenakte
  kind             String  @default("RENTAL")
  damageCaseId     String? // nur DAMAGE: die Schadenakte, deren Kundenbelastung abgerechnet wird
  damageId         String? // nur DAMAGE: der zugrunde liegende Fahrzeugschaden (Referenz)
  taxTreatment     String? // nur DAMAGE: NON_TAXABLE_DAMAGES (echter Schadensersatz, ohne USt) | TAXABLE_SERVICE (steuerpflichtiges Entgelt); bewusst gewählt

  // Phase 10: Die Rechnungsdaten liegen in unveränderlichen Fassungen (InvoiceVersion). Invoice ist nur noch die
  // logische Rechnung: Nummer, Bezug, Zeiger auf die aktuelle Fassung, interne Notiz, Änderungsprotokoll, Exportmarke.
  // Die folgenden Spalten sind Altbestand aus Phase 8/9 (Fassung 1 wurde daraus kopiert) und werden nicht mehr beschrieben.
  issueDate          DateTime? // Rechnungsdatum der Fassung 1 (Altbestand)
  servicePeriodStart DateTime? // Altbestand
  servicePeriodEnd   DateTime? // Altbestand
  currency           String    @default("EUR")
  pricesIncludeTax   Boolean? // Altbestand
  customerSnapshot   Json? // Altbestand
  companySnapshot    Json? // Altbestand
  netTotal           Decimal   @default(0) // Altbestand
  taxTotal           Decimal   @default(0) // Altbestand
  grossTotal         Decimal   @default(0) // Altbestand
  paymentTermDays    Int? // Altbestand
  paymentDueDate     DateTime? // Altbestand
  customerNote       String? // Altbestand
  taxNote            String? // Altbestand
  contentHash        String? // Altbestand (Prüfsumme der Fassung 1)
  version            Int       @default(1) // Altbestand

  notes     String? // nur intern, nie auf Dokumenten
  changeLog Json    @default("[]") // [{ at, by, summary, versionNo? }] Änderungen an Entwürfen und Fassungen

  sourceHash       String? // Prüfsummen der Quellen (Vertrag, Rückgabe) beim Erstellen
  currentVersionId String?   @unique // aktuell gültige abgeschlossene Fassung
  exportedAt       DateTime? // buchhalterisch exportiert: danach keine Fassung mehr unter dieser Nummer
  exportBatchId    String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime? // Abschluss der Fassung 1

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking        Booking          @relation(fields: [bookingId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract       RentalContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  returnHandover Handover?        @relation(fields: [returnHandoverId], references: [id], onDelete: SetNull)
  items          InvoiceItem[] // Altbestand (Positionen der Fassung 1 vor Phase 10)
  documents      Document[]
  payments       Payment[]
  versions       InvoiceVersion[] @relation("InvoiceVersions")
  currentVersion InvoiceVersion?  @relation("InvoiceCurrentVersion", fields: [currentVersionId], references: [id])
  damageCase     DamageCase?      @relation(fields: [damageCaseId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, bookingId])
  @@index([tenantId, status])
  @@index([tenantId, kind])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  sortOrder     Int      @default(0)
  description   String
  quantity      Decimal
  unit          String
  unitPrice     Decimal // je Einheit; brutto oder netto laut Invoice.pricesIncludeTax
  netAmount     Decimal
  taxRate       Decimal // Prozent, z. B. 19.00
  taxAmount     Decimal
  grossAmount   Decimal
  source        String // RENTAL | EXTRA_CHARGE | MANUAL
  extraChargeId String?
  reference     String? // interne Referenz, z. B. Vertragsnummer oder Formel
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  extraCharge ExtraCharge? @relation(fields: [extraChargeId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
}

// ============================================================================
// Phase 9: Zahlungen und Kaution. Drei getrennte Fachbereiche:
//   Invoice = Forderung, Payment = dokumentierter Geldfluss, SecurityDeposit = Sicherheitsleistung.
// Nichts davon wird automatisch miteinander verrechnet. Beträge sind ganze Cent (money.ts).
// Bestätigte Zahlungen und Kautionsbewegungen werden nie gelöscht, nur mit Grund storniert (DB-Trigger).
// ============================================================================

model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  bookingId      String
  invoiceId      String? // bei INVOICE_PAYMENT Pflicht (Trigger), sonst leer
  type           String // INVOICE_PAYMENT | OTHER_PAYMENT
  method         String // CASH | CARD | BANK_TRANSFER | OTHER; CARD/BANK_TRANSFER = außerhalb von Rent-Base ausgeführt, hier nur dokumentiert
  amountCents    Int
  currency       String   @default("EUR")
  status         String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  paidAt         DateTime
  reference      String? // z. B. Belegnummer, Verwendungszweck
  note           String?
  idempotencyKey String? // einmaliger Formularschlüssel gegen Doppelbuchung
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancellationReason String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking  @relation(fields: [bookingId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, bookingId])
  @@index([tenantId, paidAt])
}

// Kaution je Buchung. Der vereinbarte Betrag stammt aus dem abgeschlossenen Mietvertrag und ändert sich danach nicht.
// Erhalten, freigegeben und einbehalten ergeben sich ausschließlich aus den bestätigten Bewegungen; der Status
// wird in derselben Transaktion daraus abgeleitet (EXPECTED | RECEIVED | PARTIALLY_RELEASED | RELEASED | RETAINED).
model SecurityDeposit {
  id                  String   @id @default(cuid())
  tenantId            String
  bookingId           String   @unique
  contractId          String?
  expectedAmountCents Int
  currency            String   @default("EUR")
  status              String   @default("EXPECTED")
  note                String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking                @relation(fields: [bookingId], references: [id])
  contract RentalContract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  events   SecurityDepositEvent[]

  @@index([tenantId, status])
}

// Eine Bewegung der Kaution. Bestätigte Bewegungen sind unveränderlich; eine Korrektur ist ein Storno mit Grund
// (status CANCELLED), die ursprüngliche Zeile bleibt sichtbar.
model SecurityDepositEvent {
  id             String   @id @default(cuid())
  tenantId       String
  depositId      String
  type           String // RECEIVED | RELEASED | RETAINED
  amountCents    Int
  method         String? // CASH | CARD | BANK_TRANSFER | OTHER (bei RECEIVED und RELEASED)
  reference      String?
  reason         String? // Pflicht bei RETAINED
  note           String?
  occurredAt     DateTime
  status         String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  idempotencyKey String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancellationReason String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deposit SecurityDeposit @relation(fields: [depositId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, depositId, status])
}

// Protokoll kritischer Geldaktionen. Keine Kundendaten, nur Bezug, Betrag, Aktion, Benutzer, Zeitpunkt.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  action      String // PAYMENT_RECORDED | PAYMENT_CANCELLED | DEPOSIT_RECEIVED | DEPOSIT_RELEASED | DEPOSIT_PARTIALLY_RELEASED | DEPOSIT_RETAINED | DEPOSIT_CORRECTION
  bookingId   String?
  invoiceId   String?
  paymentId   String?
  depositId   String?
  amountCents Int?
  details     Json?
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, bookingId])
}

// ============================================================================
// Phase 10: Rechnungsfassungen. Invoice = logische Rechnung (Nummer bleibt), InvoiceVersion = unveränderliche Fassung.
// Jede erneute Finalisierung erzeugt eine neue Fassung aus dem Snapshot der vorherigen; nichts wird überschrieben.
// "Ersetzt" ist kein gespeicherter Status, sondern folgt aus Invoice.currentVersionId (versiegelter Inhalt bleibt unberührt).
// ============================================================================

model InvoiceVersion {
  id                  String  @id @default(cuid())
  tenantId            String
  invoiceId           String
  versionNo           Int
  kind                String // ORIGINAL | REVISION (Vorfassung nie übermittelt) | CORRECTION (Vorfassung bereits übermittelt)
  status              String  @default("DRAFT") // DRAFT | FINALIZED
  supersedesVersionId String? // Vorfassung, aus deren Snapshot dieser Entwurf entstand
  reason              String? // Grund (Pflicht bei CORRECTION); erscheint auf der berichtigten Rechnung

  issueDate          DateTime? // Rechnungsdatum (bei Fassung 1 vergeben, danach übernommen)
  correctionDate     DateTime? // Datum der Berichtigung/Neufassung (Fassung >= 2)
  servicePeriodStart DateTime
  servicePeriodEnd   DateTime
  currency           String    @default("EUR")
  pricesIncludeTax   Boolean

  customerSnapshot Json
  companySnapshot  Json

  netTotal   Decimal @default(0)
  taxTotal   Decimal @default(0)
  grossTotal Decimal @default(0)

  paymentTermDays Int?
  paymentDueDate  DateTime?
  customerNote    String?
  taxNote         String?

  contentHash      String? // sha256 über den versiegelten Inhalt dieser Fassung
  diffFromPrevious Json? // strukturierte Differenz zur Vorfassung (beim Abschluss erzeugt)

  // Übermittlung außerhalb des Rent-Base-E-Mail-Versands (manuell bestätigt), hängt an der konkreten Fassung
  deliveredAt     DateTime?
  deliveredById   String?
  deliveredByName String?
  deliveredNote   String?

  exportedAt    DateTime? // buchhalterisch exportiert (Vorbereitung, kein Export in dieser Phase)
  exportBatchId String?

  createdById     String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finalizedAt     DateTime?
  finalizedById   String?
  finalizedByName String?

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   Invoice              @relation("InvoiceVersions", fields: [invoiceId], references: [id])
  currentOf Invoice?             @relation("InvoiceCurrentVersion")
  items     InvoiceVersionItem[]
  documents Document[]
  emailLogs EmailLog[]

  @@unique([invoiceId, versionNo])
  @@index([tenantId, invoiceId, status])
}

model InvoiceVersionItem {
  id            String   @id @default(cuid())
  tenantId      String
  versionId     String
  sortOrder     Int      @default(0)
  description   String
  quantity      Decimal
  unit          String
  unitPrice     Decimal
  netAmount     Decimal
  taxRate       Decimal
  taxAmount     Decimal
  grossAmount   Decimal
  source        String // RENTAL | EXTRA_CHARGE | MANUAL
  extraChargeId String? // nur Referenz auf die Quelle der Fassung 1
  reference     String?
  createdAt     DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version InvoiceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([tenantId, versionId])
}

// ============================================================================
// Phase 12: Schadenmanagement. Damage bleibt die objektive Schadensinformation (Übergabe, Rückgabe, Skizze, Historie).
// DamageCase ist die operative Schadenakte: Prüfung, Haftung, Kosten, Reparatur, Dokumente, Kundenbelastung, Abschluss.
// Fahrzeugschaden ≠ Haftung ≠ Kundenforderung ≠ Rechnung ≠ Zahlung ≠ Kaution: jeder Übergang ist eine bewusste Entscheidung.
// ============================================================================

model DamageCase {
  id               String  @id @default(cuid())
  tenantId         String
  damageId         String  @unique // genau eine Akte je Schaden
  vehicleId        String
  bookingId        String?
  returnHandoverId String?
  caseNumber       String // SCH-2026-000001
  status           String  @default("OPEN") // OPEN | UNDER_REVIEW | REPAIR_PLANNED | IN_REPAIR | REPAIRED | CLOSED
  priority         String  @default("NORMAL") // LOW | NORMAL | HIGH
  liabilityStatus  String  @default("UNASSESSED") // UNASSESSED | UNCLEAR | CUSTOMER_RESPONSIBILITY_CONFIRMED | NOT_CUSTOMER_RESPONSIBILITY | THIRD_PARTY | INTERNAL
  liabilityNote    String? // Begründung der letzten Haftungsentscheidung

  reportedAt     DateTime
  reportedById   String?
  reportedByName String?
  description    String // Kopie der Schadensbeschreibung bei Eröffnung (Damage bleibt die Quelle)
  internalNote   String? // nie kundensichtbar

  estimatedCostCents  Int?
  actualCostCents     Int?
  currency            String    @default("EUR")
  repairProviderName  String?
  repairAppointmentAt DateTime?
  repairCompletedAt   DateTime?

  // Kundenbelastung (einmalig je Akte, bewusst festgelegt; erzeugt die Schadenabrechnung)
  customerChargeCents        Int?
  customerChargeBasis        String? // sachliche Grundlage, erscheint auf der Abrechnung
  customerChargeTaxTreatment String? // NON_TAXABLE_DAMAGES | TAXABLE_SERVICE
  customerChargeAt           DateTime?
  customerChargeByName       String?

  closedAt     DateTime?
  closedById   String?
  closedByName String?
  closeReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  damage         Damage               @relation(fields: [damageId], references: [id])
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id])
  booking        Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  returnHandover Handover?            @relation(fields: [returnHandoverId], references: [id], onDelete: SetNull)
  events         DamageCaseEvent[]
  documents      DamageCaseDocument[]
  photos         Photo[]
  invoices       Invoice[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, liabilityStatus])
  @@index([tenantId, vehicleId])
  @@index([tenantId, bookingId])
}

// Historie der Akte, nur anfügen.
model DamageCaseEvent {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  type      String // CREATED | STATUS_CHANGED | LIABILITY_CHANGED | COST_CHANGED | REPAIR_CHANGED | PHOTO_ADDED | DOCUMENT_ADDED | NOTE_ADDED | VEHICLE_BLOCKED | VEHICLE_RELEASED | CUSTOMER_CHARGE_CREATED | INVOICE_CREATED | CLOSED | REOPENED
  fromValue String?
  toValue   String?
  reason    String?
  note      String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   DamageCase @relation(fields: [caseId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

// Dokumente zur Akte (Kostenvoranschlag, Werkstattrechnung, Sonstiges), privat gespeichert, nur anfügen.
model DamageCaseDocument {
  id            String   @id @default(cuid())
  tenantId      String
  caseId        String
  type          String // ESTIMATE | REPAIR_INVOICE | OTHER
  fileName      String
  storageKey    String   @unique
  contentType   String
  sizeBytes     Int
  checksum      String
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   DamageCase @relation(fields: [caseId], references: [id])

  @@index([tenantId, caseId])
}
